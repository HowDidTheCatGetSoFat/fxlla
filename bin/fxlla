#!/usr/bin/env bash
#
# fxlla - local agent for Apple Silicon.
# Downloads models (bandwidth-capped) to an external disk, serves them over an
# OpenAI-compatible endpoint (MLX or llama.cpp per model), and registers them
# in opencode. Claude Code is left untouched.
#
# Usage:  fxlla <command> [args]   |   fxlla help

# Re-exec under bash if started by another shell (for example: zsh bin/fxlla).
if [ -z "${BASH_VERSION:-}" ]; then exec bash "$0" "$@"; fi

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
REPO_ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
. "$REPO_ROOT/lib/core.sh"

# --------------------------------------------------------------------------
cmd_help() {
  cat <<EOF
fxlla - local models (MLX + GGUF) on Apple Silicon

  fxlla setup                 Install and verify dependencies, create the store
  fxlla models                List the catalog
  fxlla pull <alias|org/repo> Download a model, capped at ${FXLLA_RATE_MBIT} Mbps
       [--gguf] [--quant Q4_K_M]
  fxlla ls [--json]           List downloaded models (--json for machine output)
  fxlla avail <alias>         Availability as JSON: cached, size, engine, repo
  fxlla on [alias] [--pull]   Start a single-model server (default: $FXLLA_DEFAULT_MODEL)
  fxlla off                   Stop the single-model server
  fxlla serve                 Multi-model gateway: one endpoint, load on demand
  fxlla unserve               Stop the gateway
  fxlla status                Server, model, and idle status
  fxlla stats [--watch]       Live metrics: RAM, TTFT, tok/s (also --json).
                              Reads the gateway's passive samples when serving.
                              --last N prints the newest N recorded samples.
  fxlla logs                  Follow the server log
  fxlla ram [auto|reset|MB]   Adjust the GPU RAM limit (use the full 128 GB)
  fxlla eval [model ...]      Score chat models on quality and speed locally
                              (mechanical checks only; see evals/README.md)
  fxlla kb add|search|ls|rm   Knowledge bases (RAG) over your files (also 'stop',
                              'reindex <name>' to re-embed after changing model,
                              and 'eval' to score retrieval on the repo docs)
  fxlla graph index|def|refs  Code graph over Python (also callers|impact|unused)
  fxlla media image "<prompt>"  Generate an image locally (mflux-cv). Also 'models'
  fxlla media video "<prompt>"  Generate a short video locally (ltx-2-mlx)
  fxlla media voice "<text>"    Synthesize speech locally (mlx-audio)
  fxlla media edit "<prompt>" --image p  Edit an image locally (mflux-cv qwen-edit)
  fxlla media upscale --image p          Upscale an image locally (mflux-cv seedvr2)
  fxlla media models          Image models and what each one supports
  fxlla media loras           LoRAs you have downloaded, and built-in styles
  fxlla media weights         Media weight catalog and what is cached
  fxlla media jobs            Background media jobs (also job <id>, cancel <id>)
  fxlla do "<what you want>"  State an outcome, not a command: fxlla decides
                              whether to make an image or edit one you named,
                              picks the model, looks at the result with the
                              vision model and retries once. Needs 'fxlla serve'
  fxlla wire-opencode [--all] Register the local provider (--all: + MCP + skills)
  fxlla skills install        Install the tool-usage skills (opencode + Claude Code)
  fxlla rm <alias>            Delete a downloaded model
  fxlla config                Show the effective configuration
  fxlla doctor                Diagnose the environment
  fxlla completions bash|zsh  Print a shell completion script

Store:     $FXLLA_STORE
Endpoint:  $BASE_URL
Keep-warm: ${FXLLA_KEEP_WARM} idle min -> auto-stop (0 = never)
EOF
}

cmd_config() {
  cat <<EOF
FXLLA_STORE          $FXLLA_STORE
FXLLA_RATE_MBIT      $FXLLA_RATE_MBIT  (~$(awk "BEGIN{printf \"%.1f\", $FXLLA_RATE_MBIT/8}") MB/s)
FXLLA_HOST:PORT      $FXLLA_HOST:$FXLLA_PORT
FXLLA_DEFAULT_MODEL  $FXLLA_DEFAULT_MODEL
FXLLA_KEEP_WARM      $FXLLA_KEEP_WARM min
FXLLA_CTX / FXLLA_NGL  $FXLLA_CTX / $FXLLA_NGL   (gguf)
FXLLA_SERVER_ARGS    ${FXLLA_SERVER_ARGS:-(empty)}
MODELS_DIR         $MODELS_DIR
STATE_DIR          $STATE_DIR
EOF
}

# Media backends, pinned to the versions the media path was validated against.
# Determinism comes from pins, not from bundling bytes: relocatable Python
# venvs cannot be signed into the app, and a multi-GB dmg would help nobody.
# ltx-2-mlx has no PyPI release, so its pin is a commit on the public repo.
MEDIA_PIN_IMAGE="mflux-cv==0.18.33"
MEDIA_PIN_VOICE="mlx-audio==0.4.6"
MEDIA_PIN_VIDEO="git+https://github.com/dgrauet/ltx-2-mlx.git@e1838a85#subdirectory=packages/ltx-pipelines-mlx"

_setup_media() {
  info "Setting up media backends (pinned versions)..."
  if command -v mflux-generate >/dev/null 2>&1; then
    ok "image backend present (mflux)"
  else
    info "Installing image backend: $MEDIA_PIN_IMAGE"; uv tool install "$MEDIA_PIN_IMAGE"
  fi
  if command -v ltx-2-mlx >/dev/null 2>&1; then
    ok "video backend present (ltx-2-mlx)"
  else
    info "Installing video backend (dgrauet/ltx-2-mlx, pinned commit)..."
    uv tool install "$MEDIA_PIN_VIDEO"
  fi
  local vp
  vp="$(python3 "$REPO_ROOT/media/generate.py" voice-python 2>/dev/null || echo python3)"
  if "$vp" -c 'import mlx_audio' >/dev/null 2>&1; then
    ok "voice backend present ($vp)"
  else
    info "Installing voice backend: $MEDIA_PIN_VOICE"; uv tool install "$MEDIA_PIN_VOICE"
  fi
  # The one genuinely personal piece: chatterbox clones a reference voice, so
  # no install can supply it.
  if [ -z "${FXLLA_VOICE_REF:-}" ]; then
    warn "Voice needs a reference wav: record a few seconds of the voice you want and set FXLLA_VOICE_REF=/path/to/it in ~/.config/fxlla/config.env"
  fi
  info "Weights are separate (tens of GB) and stay consent-gated: fxlla media weights"
}

cmd_setup() {
  local media=0
  case "${1:-}" in
    --media) media=1 ;;
    "") ;;
    *) die "usage: fxlla setup [--media]" ;;
  esac
  info "Checking dependencies..."
  command -v uv >/dev/null || die "Missing 'uv'. Install it: brew install uv"
  command -v aria2c >/dev/null || { warn "aria2c missing, installing..."; brew install aria2; }

  if command -v mlx_lm.server >/dev/null 2>&1; then
    ok "mlx-lm already installed"
  else
    info "Installing mlx-lm with uv..."; uv tool install --upgrade mlx-lm
  fi

  if command -v llama-server >/dev/null 2>&1; then
    ok "llama.cpp already installed"
  else
    info "Installing llama.cpp (for GGUF models)..."; brew install llama.cpp
  fi

  # omlx is an OPTIONAL third engine (continuous batching + an SSD KV cache that
  # survives a restart). It is not installed here on purpose: its build pins
  # mlx==0.32.0 and would fight the mlx the MLX engine uses if dropped in the
  # same environment. Install it isolated when you want it:
  #   brew tap jundot/omlx https://github.com/jundot/omlx && brew install jundot/omlx/omlx
  if command -v omlx >/dev/null 2>&1; then
    ok "omlx already installed (OMLX engine)"
  else
    info "omlx not installed (optional). For OMLX models: brew tap jundot/omlx https://github.com/jundot/omlx && brew install jundot/omlx/omlx"
  fi

  # MTPLX is the other optional MTP engine (native speculative decode). Same
  # reason it is not auto-installed: it pins its own mlx and belongs in a venv.
  if command -v "${FXLLA_MTPLX_BIN:-mtplx}" >/dev/null 2>&1; then
    ok "mtplx already installed (MTPLX engine)"
  else
    info "mtplx not installed (optional). For MTPLX models: python3 -m venv ~/mtplx/.venv && ~/mtplx/.venv/bin/pip install mtplx, then set FXLLA_MTPLX_BIN"
  fi

  [ "$media" = 1 ] && _setup_media

  local uvbin="$HOME/.local/bin"
  echo ":$PATH:" | grep -q ":$uvbin:" || warn "Add to your shell rc: export PATH=\"$uvbin:\$PATH\""

  require_store
  ok "Store ready at $MODELS_DIR"
  if [ "$media" = 1 ]; then
    ok "Setup complete. Try: fxlla models  |  fxlla media image \"a cat\""
  else
    ok "Setup complete. Try: fxlla models   (media backends: fxlla setup --media)"
  fi
}

cmd_models() {
  printf "%-18s %-8s %-8s %-6s %s\n" "ALIAS" "SIZE" "ROLE" "ENGINE" "NOTE"
  printf "%-18s %-8s %-8s %-6s %s\n" "-----" "----" "----" "------" "----"
  local line alias size role engine note
  while IFS= read -r line; do
    case "$line" in \#*|'') continue;; esac
    alias="$(trim "$(echo "$line"  | cut -d'|' -f1)")"; [ -z "$alias" ] && continue
    size="$(trim "$(echo "$line"   | cut -d'|' -f3)")"
    role="$(trim "$(echo "$line"   | cut -d'|' -f4)")"
    engine="$(trim "$(echo "$line" | cut -d'|' -f5)")"
    note="$(trim "$(echo "$line"   | cut -d'|' -f6)")"
    printf "%-18s %-8s %-8s %-6s %s\n" "$alias" "$size" "$role" "${engine:-mlx}" "$note"
  done < "$CATALOG"
}

# --------------------------------------------------------------------------
# Extract the numeric model-version id from a Civitai reference, or fail:
#   civitai:12345
#   https://civitai.com/api/download/models/12345
#   https://civitai.com/models/999?modelVersionId=12345
_civitai_version_id() {
  local ref="$1" vid=""
  case "$ref" in
    civitai:*)                              vid="${ref#civitai:}" ;;
    *civitai.com/api/download/models/*)     vid="${ref##*/models/}"; vid="${vid%%[?&]*}" ;;
    *civitai.com/*modelVersionId=*)         vid="${ref##*modelVersionId=}"; vid="${vid%%[&#]*}" ;;
    *)                                      return 1 ;;
  esac
  case "$vid" in ''|*[!0-9]*) return 1 ;; esac
  printf '%s\n' "$vid"
}

# Download a single file from Civitai (LoRA, checkpoint) to <store>/civitai.
# Total size of a Civitai model-version, in GB, or empty when unknown. A Civitai
# "single file" is routinely a 2-24 GB checkpoint, so this is worth asking about;
# an unreadable size fails closed inside require_download_consent.
_civitai_size_gb() {
  VID="$1" python3 -c 'import json,os,urllib.request
try:
    u="https://civitai.com/api/v1/model-versions/%s"%os.environ["VID"]
    d=json.load(urllib.request.urlopen(urllib.request.Request(u,headers={"User-Agent":"fxlla"}),timeout=20))
    kb=sum((f.get("sizeKB") or 0) for f in (d.get("files") or []))
    print("%.2f"%(kb/1048576.0) if kb else "")
except Exception:
    print("")' 2>/dev/null || true
}

_pull_civitai() {
  need aria2c; require_store
  local assume=0 ref="" arg
  for arg in "$@"; do
    case "$arg" in
      --yes|-y) assume=1 ;;
      -*)       die "unknown flag: $arg" ;;
      *)        ref="$arg" ;;
    esac
  done
  local vid; vid="$(_civitai_version_id "$ref")" \
    || die "civitai needs a numeric model-version id (civitai:<id> or a civitai.com URL)"
  [ "$assume" = 1 ] || require_download_consent "$(_civitai_size_gb "$vid")" \
    "civitai model-version $vid"
  local dir="$FXLLA_STORE/civitai"; mkdir -p "$dir"
  local url="https://civitai.com/api/download/models/$vid"
  # Civitai authenticates with a token query parameter (its documented method).
  # Unlike an Authorization header, the token then goes only to civitai.com and
  # is not resent on the redirect to the CDN. --auto-file-renaming=false keeps a
  # re-run from writing a numbered duplicate, matching the HF pull path.
  [ -n "${FXLLA_CIVITAI_TOKEN:-}" ] && url="$url?token=$FXLLA_CIVITAI_TOKEN"
  info "Civitai:  model-version $vid -> $dir"
  info "Cap:      ${FXLLA_RATE_MBIT} Mbps"
  # shellcheck disable=SC2086  # the stall guard is a deliberate word split
  aria2c --dir="$dir" --continue=true --auto-file-renaming=false \
    --max-overall-download-limit="$(rate_bytes)" \
    $ARIA_STALL_GUARD \
    --content-disposition-default-utf8=true "$url" \
    || die "civitai download failed (is FXLLA_CIVITAI_TOKEN set and the id valid?)"
  ok "Downloaded to $dir"
}

# Pre-fetch the weights a media alias needs (config/media.conf) into the media
# Hugging Face cache, so a render does not stop to download mid-job. Media weights
# go to the HF cache, not FXLLA_STORE: the toolchains resolve them by repo id via
# huggingface_hub, so the cache layout is what matters. That means the Hugging Face
# CLI does the transfer and the bandwidth cap does not apply here.
_pull_media() {
  local alias="" assume=0 arg
  for arg in "$@"; do
    case "$arg" in
      --yes|-y) assume=1 ;;
      -*)       die "unknown flag: $arg" ;;
      *)        [ -n "$alias" ] && die "give one media alias, not '$alias' and '${arg#media:}'"
                alias="${arg#media:}" ;;
    esac
  done
  [ -n "$alias" ] || die "usage: fxlla pull media:<alias> [--yes]"
  local repos size kind include
  repos="$(_media_field "$alias" 2 || true)"
  [ -z "$repos" ] && die "unknown media weight '$alias'. See: fxlla media weights"
  size="$(_media_field "$alias" 3 || true)"
  kind="$(_media_field "$alias" 4 || true)"
  include="$(_media_field "$alias" 5 || true)"
  local home; home="$(media_hf_write_root)"
  info "Media:    $alias ($kind), about $size"
  if [ -n "$(media_hf_home)" ]; then
    info "Cache:    $home (new downloads)"
    local _r _n=0
    while IFS= read -r _r; do
      [ -n "$_r" ] || continue
      _n=$((_n+1))
      [ "$_n" -gt 1 ] && info "          $_r (searched)"
    done <<EOF
$(media_hf_roots)
EOF
  else
    info "Cache:    the Hugging Face default (~/.cache/huggingface)"
  fi
  info "Transfer: Hugging Face CLI (no bandwidth cap)"
  local repo inc=() tok=() pat
  [ -n "${HF_TOKEN:-}" ] && tok=(--token "$HF_TOKEN")
  if [ -n "$include" ] && [ "$include" != "-" ]; then
    # comma separated globs, so only the needed files are fetched
    local IFS_SAVE="$IFS"; IFS=','
    for pat in $include; do inc+=(--include "$pat"); done
    IFS="$IFS_SAVE"
  fi
  IFS=',' read -r -a _repolist <<< "$repos"
  # Work out what is missing before asking, so a fully cached alias never stops.
  local pending=() cached=0
  for repo in "${_repolist[@]}"; do
    if media_repo_cached "$repo"; then ok "already cached: $repo"; cached=1
    else pending+=("$repo"); fi
  done
  if [ "${#pending[@]}" -eq 0 ]; then
    ok "media weights ready for '$alias'"
    return 0
  fi
  # The catalog carries one size per alias, so when part of a multi-repo alias is
  # already cached the real remainder is smaller. Say "up to" rather than print a
  # number that contradicts the "already cached" lines above.
  local label="media weights '$alias'"
  [ "$cached" = 1 ] && label="the rest of media weights '$alias' (up to the full size)"
  [ "$assume" = 1 ] || require_download_consent \
    "$(printf '%s' "$size" | tr -cd '0-9.')" "$label"
  for repo in "${pending[@]}"; do
    # Only a real transfer needs uv, so a fully cached alias works without it.
    need uv
    info "Downloading $repo ..."
    HF_HOME="$home" \
      uvx --from "huggingface_hub[hf_xet]" hf download "$repo" \
      ${inc[@]+"${inc[@]}"} ${tok[@]+"${tok[@]}"} \
      || die "hf download failed for $repo (gated without HF_TOKEN? typo?)"
  done
  ok "media weights ready for '$alias'"
}

# List the media catalog with what is already cached.
_media_weights() {
  local line alias repos size kind repo state
  printf '%-14s %-8s %-6s %s\n' ALIAS KIND SIZE STATE
  while IFS= read -r line; do
    case "$line" in \#*|'') continue;; esac
    alias="$(trim "$(echo "$line" | cut -d'|' -f1)")"
    repos="$(trim "$(echo "$line" | cut -d'|' -f2)")"
    size="$(trim "$(echo "$line" | cut -d'|' -f3)")"
    kind="$(trim "$(echo "$line" | cut -d'|' -f4)")"
    state=cached
    IFS=',' read -r -a _rl <<< "$repos"
    for repo in "${_rl[@]}"; do
      media_repo_cached "$repo" || { state=missing; break; }
    done
    printf '%-14s %-8s %-6s %s\n' "$alias" "$kind" "$size" "$state"
  done < "$MEDIA_CATALOG"
  echo
  info "Pull one with: fxlla pull media:<alias>"
}

cmd_pull() {
  # Civitai and media weights are separate sources with their own layout.
  case "${1:-}" in
    civitai:*|*civitai.com/*) _pull_civitai "$@"; return ;;
    media:*)                  _pull_media "$@"; return ;;
  esac
  need python3; require_store
  local q="" engine="" quant="" assume=0 downloader="${FXLLA_DOWNLOADER:-aria2}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --gguf)         engine=gguf ;;
      --mlx)          engine=mlx ;;
      --omlx)         engine=omlx ;;
      --mtplx)        engine=mtplx ;;
      --quant)        quant="$2"; shift ;;
      --quant=*)      quant="${1#--quant=}" ;;
      --downloader)   downloader="$2"; shift ;;
      --downloader=*) downloader="${1#--downloader=}" ;;
      --yes|-y)       assume=1 ;;
      -*)             die "unknown flag: $1" ;;
      *)              q="$1" ;;
    esac; shift
  done
  [ -z "$q" ] && die "Usage: fxlla pull <alias|org/repo|civitai:<id>|media:<alias>> [--gguf|--mlx|--omlx|--mtplx] [--quant Q4_K_M] [--downloader aria2|hf] [--yes|-y]"
  case "$downloader" in aria2|hf) ;; *) die "unknown downloader: $downloader (aria2|hf)" ;; esac
  [ "$downloader" = hf ] || need aria2c

  local repo; repo="$(resolve_repo "$q")" || die "Unknown '$q'. See 'fxlla models' or pass an org/repo from HF."
  [ -z "$engine" ] && engine="$(resolve_engine "$q")"
  [ -z "$engine" ] && engine=mlx
  local name; name="$(local_name "$q")"
  local dest="$MODELS_DIR/$name"

  info "Model:    $repo"
  info "Engine:   $engine"
  info "Dest:     $dest"

  local listing; listing="$(_hf_list "$repo")" || die "Could not list $repo (typo? gated without HF_TOKEN?)"
  [ -z "$listing" ] && die "Empty or inaccessible repo: $repo"

  # select files
  local sel=""
  if [ "$engine" = gguf ]; then
    local ggufs; ggufs="$(echo "$listing" | awk -F'\t' '$2 ~ /\.gguf$/ {print $2}')"
    [ -z "$ggufs" ] && die "No .gguf files in $repo"
    # Count and offer the WEIGHTS, never the projector. A projector is not a
    # quant to choose between: it carries its own quant tag and it ships
    # alongside whichever build you pick. Counting every .gguf made a repo with
    # one build and one projector look like a repo with two builds, so
    # `fxlla pull gemma-4-12b-qat` refused a model that has nothing to choose,
    # and offered `mmproj-...` as one of the options - a file that is not a
    # model and cannot be served as one.
    local builds; builds="$(echo "$ggufs" | grep -iv 'mmproj' || true)"
    [ -z "$builds" ] && die "No weights in $repo, only a projector"
    if [ -n "$quant" ]; then
      sel="$(echo "$ggufs" | grep -i -- "$quant" || true)"
      [ -z "$sel" ] && { warn "No quant '$quant'. Available:"; echo "$builds" | while IFS= read -r l; do echo "  $l"; done >&2; exit 1; }
      # A quant that matches ONLY a projector selects no model at all, and the
      # emptiness surfaced nowhere: `--quant mmproj` downloaded the projector,
      # wrote a blank .entry, and printed "Done" plus how to start a directory
      # with nothing to start. Non-empty is not the same as usable.
      if [ -z "$(echo "$sel" | grep -iv 'mmproj' || true)" ]; then
        warn "'--quant $quant' matches only a projector, which is not a model. Builds:"
        echo "$builds" | while IFS= read -r l; do echo "  $l"; done >&2
        die "Name one of those instead."
      fi
    elif [ "$(echo "$builds" | grep -c .)" -eq 1 ]; then
      sel="$builds"
    else
      warn "This repo has several quants. Choose with --quant <substr>, for example:"
      echo "$builds" | while IFS= read -r l; do echo "  $l"; done >&2
      die "Recommended for this RAM: Q4_K_M (balanced) or Q5_K_M / Q6_K (higher quality)."
    fi
    # A vision model is two files: the weights and a multimodal projector,
    # carrying its OWN quant tag. Selecting by --quant alone leaves the
    # projector behind and the model cannot see; it is under 1.5 GB, so take
    # every one the repo has rather than guess which pairs.
    #
    # Matched ANYWHERE in the name, not anchored. Publishers disagree about
    # where the word goes: empero-ai ships `mmproj-Qwythos-27B-F16.gguf`, and
    # mradermacher ships `Qwen3.5-9B.mmproj-Q8_0.gguf` - the model name first.
    # An anchored `^mmproj` sees only the first kind, so every vision model
    # from the second publisher arrived with no projector at all and served
    # text-only, with nothing failing to say so. Four models on this machine
    # were pulled that way - both 27B builds and both 4B builds - counted by
    # asking each repo what it ships and comparing against the directory,
    # rather than from memory, which had it as three.
    #
    # "Every one the repo has" is literal: a repo shipping an f16 and a Q8_0
    # projector yields both, so a 7.4 GB weights pull lands as 8.9 GB.
    local mmproj; mmproj="$(echo "$ggufs" | grep -i 'mmproj' || true)"
    [ -n "$mmproj" ] && sel="$(printf '%s\n%s\n' "$sel" "$mmproj" | sort -u | grep .)"
    # The entry is the model, never the projector: with --quant Q8_0 both match
    # and a plain head -1 could launch llama-server on the projector. Same
    # unanchored test, for the same reason - anchoring here would let
    # `X.mmproj-Q6_K.gguf` be picked as the weights under `--quant Q6_K`.
    local weights; weights="$(echo "$sel" | grep -iv 'mmproj' || true)"
    local entry; entry="$(echo "$weights" | grep -- '-00001-of-' | head -1 || true)"
    if [ -z "$entry" ]; then
      # An ambiguous --quant is a substring, and a substring matches more than
      # one build in repos that ship variants at the same quant: Q6_K hits both
      # `<model>-Q6_K.gguf` and `<model>-MTP-Q6_K.gguf`. Downloading both is
      # twice the bytes, and .entry then silently became whichever sorted
      # first - so the model you ran was chosen by alphabetical accident.
      if [ "$(echo "$weights" | grep -c .)" -gt 1 ]; then
        warn "'--quant $quant' matches more than one build:"
        echo "$weights" | while IFS= read -r l; do echo "  $l"; done >&2
        die "Narrow it: pass enough of the file name to select exactly one."
      fi
      entry="$(echo "$weights" | head -1)"
    fi
  else
    sel="$(echo "$listing" | awk -F'\t' '{print $2}')"
  fi

  # total size of the selection
  local total gb
  total="$(awk -F'\t' 'NR==FNR{w[$1]=1;next} ($2 in w){s+=$1} END{printf "%d", s+0}' \
      <(echo "$sel") <(echo "$listing"))"
  # Discount whatever is already on disk, so resuming an interrupted pull asks
  # about the remainder instead of the original size.
  local have remaining
  have="$(awk -F'\t' -v d="$dest" '
      NR==FNR { w[$1]=1; next }
      ($2 in w) {
        cmd = "stat -f%z \"" d "/" $2 "\" 2>/dev/null || echo 0"
        cmd | getline local_size; close(cmd)
        s += (local_size+0 > $1+0 ? $1 : local_size)
      }
      END { printf "%d", s+0 }' <(echo "$sel") <(echo "$listing"))"
  remaining=$(( total - have ))
  [ "$remaining" -lt 0 ] && remaining=0
  gb="$(awk -v b="$remaining" 'BEGIN{printf "%.2f", b/1073741824}')"
  if [ "$have" -gt 0 ]; then
    info "Cap:      ${FXLLA_RATE_MBIT} Mbps | remaining: ${gb} GB (resuming)"
  else
    info "Cap:      ${FXLLA_RATE_MBIT} Mbps | to download: ${gb} GB"
  fi
  [ "$assume" = 1 ] || require_download_consent "$gb" "$repo"

  # Only now touch the filesystem: a refusal above must leave nothing behind.
  mkdir -p "$dest"
  if [ "$engine" = gguf ]; then
    echo "gguf" > "$dest/.engine"; basename "$entry" > "$dest/.entry"
  else
    # Was a hardcoded "mlx", which silently mislabelled anything that is not
    # gguf: a --omlx pull wrote mlx here and every reader then launched
    # mlx_lm.server on an omlx directory. Engine is non-empty by now (defaulted
    # above), so echo what was actually resolved.
    echo "$engine" > "$dest/.engine"
  fi

  if [ "$downloader" = hf ]; then
    # Native Hugging Face downloader via the CLI, run with uvx so no persistent
    # install is needed (uv is a dependency). Robust for xet-backed and LFS
    # repos, but it does not honor the bandwidth cap. Opt-in via --downloader hf.
    need uv
    info "Downloading via the Hugging Face CLI (uvx; no bandwidth cap)..."
    local inc=() tokopt=() f
    while IFS= read -r f; do [ -n "$f" ] && inc+=(--include "$f"); done <<< "$sel"
    [ -n "${HF_TOKEN:-}" ] && tokopt=(--token "$HF_TOKEN")
    uvx --from "huggingface_hub[hf_xet]" hf download "$repo" --local-dir "$dest" \
      ${inc[@]+"${inc[@]}"} ${tokopt[@]+"${tokopt[@]}"} \
      || die "hf download failed for $repo (typo? gated without HF_TOKEN?)"
  else
    # build aria2c input
    local input; input="$(mktemp)"
    local p d
    while IFS= read -r p; do
      [ -z "$p" ] && continue
      d="$dest"; case "$(dirname "$p")" in .) ;; *) d="$dest/$(dirname "$p")";; esac
      printf '%s\n  dir=%s\n  out=%s\n' "https://huggingface.co/$repo/resolve/main/$p" "$d" "$(basename "$p")" >> "$input"
    done <<< "$sel"

    local auth=(); [ -n "${HF_TOKEN:-}" ] && auth=(--header="Authorization: Bearer $HF_TOKEN")

    info "Downloading (resumable; Ctrl-C and re-run the same command to resume)..."
    # shellcheck disable=SC2086  # the stall guard is a deliberate word split
    aria2c --input-file="$input" \
      --max-overall-download-limit="$(rate_bytes)" \
      --continue=true --auto-file-renaming=false \
      --max-connection-per-server=4 --max-concurrent-downloads=2 --split=4 \
      $ARIA_STALL_GUARD \
      --summary-interval=10 --console-log-level=warn ${auth[@]+"${auth[@]}"}

    rm -f "$input"
    if find "$dest" -name '*.aria2' -print -quit | grep -q .; then
      die "Download incomplete (pending .aria2 files). Re-run to resume: fxlla pull $q"
    fi
  fi
  echo "$repo" > "$dest/.source"
  ok "Done: $dest"
  # An embedding model is not a chat model: 'fxlla on embed-small' would try to
  # serve one, and following that suggestion is exactly how a non-chat model ends
  # up registered as the local model in an editor.
  if [ "$(_catalog_field "$q" 4 2>/dev/null || true)" = embed ]; then
    ok "Select it with: export FXLLA_EMBED_MODEL=$name"
    ok "Existing knowledge bases need 'fxlla kb reindex <name>' to use it."
  else
    ok "Start it with: fxlla on $name"
  fi
}

cmd_ls() {
  require_store
  if [ "${1:-}" = "--json" ]; then
    # Machine-readable list of cached (complete) models: alias, size, engine, repo.
    MODELS_DIR="$MODELS_DIR" python3 - <<'PY'
import json, os, subprocess
md = os.environ["MODELS_DIR"]
out = []
if os.path.isdir(md):
    for n in sorted(os.listdir(md)):
        d = os.path.join(md, n)
        if not os.path.isdir(d) or not os.path.exists(os.path.join(d, ".source")):
            continue
        eng = "mlx"
        try:
            with open(os.path.join(d, ".engine")) as f:
                eng = f.read().strip() or "mlx"
        except OSError:
            pass
        try:
            with open(os.path.join(d, ".source")) as f:
                repo = f.read().strip()
        except OSError:
            repo = ""
        try:
            kb = int(subprocess.check_output(["du", "-sk", d]).split()[0])
        except Exception:
            kb = 0
        out.append({"alias": n, "cached": True, "size_mb": kb // 1024,
                    "engine": eng, "repo": repo})
print(json.dumps(out))
PY
    return
  fi
  local found=0 d n sz eng
  for d in "$MODELS_DIR"/*/; do
    [ -d "$d" ] || continue
    found=1; n="$(basename "$d")"
    sz="$(du -sh "$d" 2>/dev/null | cut -f1)"
    eng="mlx"; [ -f "$d/.engine" ] && eng="$(cat "$d/.engine")"
    printf "%-28s %-7s %-5s %s\n" "$n" "$sz" "$eng" "$([ -f "$d/.source" ] && cat "$d/.source")"
  done
  if [ "$found" = 0 ]; then warn "No models downloaded yet. Try: fxlla pull tiny"; fi
}

# Per-model availability as JSON: whether it is cached, its engine, repo, and
# size. For a catalog model that is not cached, report the download size.
cmd_avail() {
  require_store
  local q="${1:-}"; [ -n "$q" ] || die "usage: fxlla avail <alias>"
  local name dest repo engine size
  name="$(local_name "$q")"
  dest="$MODELS_DIR/$name"
  repo="$(resolve_repo "$q" 2>/dev/null || true)"
  engine="$(resolve_engine "$q" 2>/dev/null || true)"
  size="$(_catalog_field "$q" 3 2>/dev/null || true)"
  DEST="$dest" ALIAS="$name" REPO="$repo" ENGINE="$engine" SIZE="$size" python3 - <<'PY'
import json, os, subprocess
dest = os.environ["DEST"]; alias = os.environ["ALIAS"]
repo = os.environ["REPO"]; engine = os.environ["ENGINE"]; size = os.environ["SIZE"]
cached = os.path.isdir(dest) and os.path.exists(os.path.join(dest, ".source"))
# size_mb is always present and uniformly typed: the real disk size when
# cached, else null (the exact size is unknown until downloaded). catalog_size
# carries the human-readable estimate for a not-yet-cached model.
info = {"alias": alias, "cached": cached, "known": bool(repo) or cached,
        "engine": engine or "mlx", "repo": repo,
        "size_mb": None, "catalog_size": size or None}
if cached:
    try:
        with open(os.path.join(dest, ".engine")) as f:
            info["engine"] = f.read().strip() or "mlx"
    except OSError:
        pass
    try:
        with open(os.path.join(dest, ".source")) as f:
            info["repo"] = f.read().strip() or repo
    except OSError:
        pass
    try:
        kb = int(subprocess.check_output(["du", "-sk", dest]).split()[0])
    except Exception:
        kb = 0
    info["size_mb"] = kb // 1024
    info["catalog_size"] = None
print(json.dumps(info))
PY
}

# --------------------------------------------------------------------------
# GPU RAM limit (unified memory)
cmd_ram() {
  local total_mb cur reserve rec eff
  total_mb=$(( $(sysctl -n hw.memsize) / 1048576 ))
  cur="$(sysctl -n iogpu.wired_limit_mb 2>/dev/null || echo 0)"
  reserve="${FXLLA_RAM_RESERVE_MB:-8192}"
  rec=$(( total_mb - reserve ))
  case "${1:-show}" in
    show)
      eff="$cur"; [ "$cur" = 0 ] && eff="$(( total_mb * 3 / 4 ))"
      info "Total RAM:          ${total_mb} MB"
      info "wired_limit_mb:     ${cur} $([ "$cur" = 0 ] && echo '(0 = macOS default ~75%)')"
      info "GPU can reserve:    ~${eff} MB now"
      info "recommended:        ${rec} MB (leaves ${reserve} MB for the OS)"
      info "Apply:  fxlla ram auto     |  Revert:  fxlla ram reset"
      info "Persist across reboots:  fxlla ram persist  |  Remove:  fxlla ram unpersist"
      ;;
    auto)      _set_ram "$rec" ;;
    reset)     _set_ram 0 ;;
    persist)   _ram_persist "$rec" ;;
    unpersist) _ram_unpersist ;;
    *)         [[ "${1:-}" =~ ^[0-9]+$ ]] || die "Usage: fxlla ram [auto|reset|persist|unpersist|<MB>]"; _set_ram "$1" ;;
  esac
}
_set_ram() {
  local mb="$1"
  info "sudo sysctl iogpu.wired_limit_mb=$mb ..."
  sudo sysctl -w iogpu.wired_limit_mb="$mb" >/dev/null
  ok "Done: wired_limit_mb=$mb  (reverts on reboot; persist with 'fxlla ram persist')"
}

RAM_DAEMON_LABEL="com.fxlla.wiredlimit"
RAM_DAEMON_PLIST="/Library/LaunchDaemons/$RAM_DAEMON_LABEL.plist"

# The LaunchDaemon plist that re-applies the wired limit at every boot.
_ram_plist_content() {
  cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$RAM_DAEMON_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/sbin/sysctl</string>
    <string>-w</string>
    <string>iogpu.wired_limit_mb=$1</string>
  </array>
  <key>RunAtLoad</key><true/>
</dict>
</plist>
PLIST
}

_ram_persist() {
  local mb="$1"
  info "Installing a LaunchDaemon to set iogpu.wired_limit_mb=$mb at boot (sudo)..."
  _ram_plist_content "$mb" | sudo tee "$RAM_DAEMON_PLIST" >/dev/null || die "could not write $RAM_DAEMON_PLIST"
  sudo launchctl unload "$RAM_DAEMON_PLIST" 2>/dev/null || true
  sudo launchctl load "$RAM_DAEMON_PLIST" || die "could not load the LaunchDaemon"
  sudo sysctl -w iogpu.wired_limit_mb="$mb" >/dev/null
  ok "Persisted: wired_limit_mb=$mb reapplies on every boot. Remove: fxlla ram unpersist"
}

_ram_unpersist() {
  if [ ! -f "$RAM_DAEMON_PLIST" ]; then
    warn "No fxlla wired-limit LaunchDaemon installed."; return 0
  fi
  info "Removing the LaunchDaemon (sudo)..."
  sudo launchctl unload "$RAM_DAEMON_PLIST" 2>/dev/null || true
  sudo rm -f "$RAM_DAEMON_PLIST"
  ok "Removed. The wired limit returns to the macOS default on the next boot."
}

# --------------------------------------------------------------------------
# opencode: register or update the local provider
_sync_opencode() {
  local model_id="$1" label="$2"
  local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json"
  mkdir -p "$(dirname "$cfg")"
  BASE_URL="$BASE_URL" MODEL_ID="$model_id" LABEL="$label" CFG="$cfg" python3 - <<'PY'
import os, json
cfg = os.environ["CFG"]
try:
    with open(cfg) as f: data = json.load(f)
except Exception:
    data = {}
data.setdefault("$schema", "https://opencode.ai/config.json")
loc = data.setdefault("provider", {}).setdefault("local", {})
loc["npm"] = "@ai-sdk/openai-compatible"
loc["name"] = "Local (MLX/llama.cpp)"
opts = loc.setdefault("options", {})
opts["baseURL"] = os.environ["BASE_URL"]
# The local servers validate no key, but opencode prompts for one when the
# provider does not carry it. Any non-empty string satisfies both sides;
# setdefault keeps a value the user chose themselves.
opts.setdefault("apiKey", "local")
mid = os.environ.get("MODEL_ID", "")
if mid:
    loc["models"] = { mid: { "name": os.environ["LABEL"] } }
else:
    loc.setdefault("models", {})
with open(cfg, "w") as f: json.dump(data, f, indent=2)
print(cfg)
PY
}

cmd_wire_opencode() {
  need python3
  local all=0
  case "${1:-}" in
    --all|--mcp) all=1 ;;
    "") ;;
    *) die "unknown flag: $1 (try --all)" ;;
  esac
  local cfg; cfg="$(_sync_opencode "" "")"
  ok "opencode configured: $cfg"
  info "Provider 'local' -> $BASE_URL (the active model is registered on 'fxlla on')."
  if [ "$all" = 1 ]; then
    _wire_rag_mcp
    _wire_graph_mcp
    _wire_media_mcp
    _skills_install_opencode "$REPO_ROOT/skills"
    ok "All MCP servers registered and skills installed. Restart opencode to load them."
  fi
}

# Install the skill pack: guidance that tells a model when to use the fxlla
# tools (knowledge base, code graph, media) and the download-consent flow.
cmd_skills() {
  case "${1:-}" in
    install) shift; _skills_install "$@" ;;
    ls|list)
      local d
      for d in "$REPO_ROOT/skills"/*/; do [ -d "$d" ] && basename "$d"; done ;;
    status) _skills_status ;;
    *) die "usage: fxlla skills install [--client all|opencode|claude] | ls | status" ;;
  esac
}

# Compares each installed copy against the repo. An installed copy that drifted
# is worse than a missing one: the model keeps following stale guidance.
_skills_status() {
  local src="$REPO_ROOT/skills" d name
  local claude="$HOME/.claude/skills"
  local store="${XDG_DATA_HOME:-$HOME/.local/share}/fxlla/skills"
  printf '%-22s %-14s %s\n' SKILL CLAUDE OPENCODE
  for d in "$src"/*/; do
    [ -f "$d/SKILL.md" ] || continue
    name="$(basename "$d")"
    printf '%-22s %-14s %s\n' "$name" \
      "$(_skill_state "$d/SKILL.md" "$claude/$name/SKILL.md")" \
      "$(_skill_state "$d/SKILL.md" "$store/$name/SKILL.md")"
  done
  echo
  info "Refresh with: fxlla skills install"
}

# current | differs | missing, by content hash
_skill_state() {
  local repo="$1" installed="$2"
  [ -f "$installed" ] || { printf 'missing'; return; }
  if [ "$(shasum -a 256 < "$repo" | cut -d' ' -f1)" = "$(shasum -a 256 < "$installed" | cut -d' ' -f1)" ]; then
    printf 'current'
  else
    printf 'differs'
  fi
}

_skills_install() {
  local client="all"
  while [ $# -gt 0 ]; do
    case "$1" in
      --client) client="$2"; shift ;;
      -*) die "unknown flag: $1" ;;
      *) die "unexpected argument: $1 (use --client <all|opencode|claude>)" ;;
    esac; shift
  done
  case "$client" in all|opencode|claude) ;; *) die "unknown client: $client (all|opencode|claude)" ;; esac
  local src="$REPO_ROOT/skills"
  [ -d "$src" ] || die "no skills directory at $src"
  # Validate every skill before writing anything, so a bad one cannot leave a
  # half-installed pack behind.
  _skills_validate "$src" || die "fix the skill(s) above and re-run"
  [ "$client" = opencode ] || _skills_install_claude "$src"
  [ "$client" = claude ] || _skills_install_opencode "$src"
}

# A client silently ignores a skill whose frontmatter is malformed, and the
# symptom is "the model just never uses the tool", which is near-undebuggable.
# Check the three things that actually break loading.
_skills_validate() {
  need python3
  SRC="$1" python3 - <<'PY'
import os, re, sys, glob

NAME_RE = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")
problems = []
for path in sorted(glob.glob(os.path.join(os.environ["SRC"], "*", "SKILL.md"))):
    directory = os.path.basename(os.path.dirname(path))
    with open(path, encoding="utf-8") as fh:
        text = fh.read()
    if not text.startswith("---\n"):
        problems.append(f"{directory}: no YAML frontmatter (must start with ---)")
        continue
    end = text.find("\n---", 3)
    if end == -1:
        problems.append(f"{directory}: frontmatter is not closed with ---")
        continue
    fields = {}
    for line in text[4:end].splitlines():
        if line.startswith((" ", "\t")) or ":" not in line:
            continue
        key, _, value = line.partition(":")
        fields[key.strip()] = value.strip()
    name = fields.get("name", "")
    description = fields.get("description", "")
    if not NAME_RE.match(name):
        problems.append(f"{directory}: name '{name}' must be lowercase words joined by -")
    elif len(name) > 64:
        problems.append(f"{directory}: name is longer than 64 characters")
    elif name != directory:
        problems.append(f"{directory}: frontmatter name '{name}' must match the directory")
    if not description:
        problems.append(f"{directory}: description is empty")
    elif len(description) > 1024:
        problems.append(f"{directory}: description is longer than 1024 characters")

for p in problems:
    print("  invalid skill: " + p, file=sys.stderr)
sys.exit(1 if problems else 0)
PY
}

# Marker written into every skill directory fxlla installs. ~/.claude/skills is
# shared with other tools, so only directories carrying this file may be removed.
SKILL_MARKER=".fxlla-managed"

# Removes managed skill directories under $1 that the repo no longer ships, so a
# renamed or deleted skill stops telling the model to use a tool that changed.
_skills_prune() {
  local dest="$1" src="$2" d name removed=0
  [ -d "$dest" ] || return 0
  for d in "$dest"/*/; do
    [ -d "$d" ] || continue
    name="$(basename "$d")"
    [ -f "$d/$SKILL_MARKER" ] || continue   # not ours: leave it alone
    [ -f "$src/$name/SKILL.md" ] && continue
    rm -rf "$d"
    removed=$((removed + 1))
    info "removed stale skill: $name"
  done
  return 0
}

# Copies one skill directory wholesale (SKILL.md plus any references/ or
# scripts/), replacing the destination so a file dropped upstream does not linger.
_skills_copy_one() {
  local from="$1" to="$2"
  rm -rf "$to"
  mkdir -p "$to"
  cp -R "$from/." "$to/"
  printf 'installed by fxlla; safe to delete\n' > "$to/$SKILL_MARKER"
}

# Claude Code reads skills from ~/.claude/skills/<name>/SKILL.md.
_skills_install_claude() {
  local src="$1" dest="$HOME/.claude/skills" d name
  mkdir -p "$dest"
  _skills_prune "$dest" "$src"
  for d in "$src"/*/; do
    [ -f "$d/SKILL.md" ] || continue
    name="$(basename "$d")"
    _skills_copy_one "$d" "$dest/$name"
  done
  ok "Claude Code skills installed: $dest"
}

# opencode includes extra guidance via the 'instructions' file list in its
# config. Copy the skills to a stable location first and point opencode there,
# so the instructions survive the repo being moved or re-cloned elsewhere.
_skills_install_opencode() {
  local src="$1" cfg="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json"
  local store="${XDG_DATA_HOME:-$HOME/.local/share}/fxlla/skills" d name
  need python3; mkdir -p "$(dirname "$cfg")" "$store"
  _skills_prune "$store" "$src"
  for d in "$src"/*/; do
    [ -f "$d/SKILL.md" ] || continue
    name="$(basename "$d")"
    _skills_copy_one "$d" "$store/$name"
  done
  CFG="$cfg" SRC="$store" python3 - <<'PY'
import os, json, glob
cfg = os.environ["CFG"]
try:
    with open(cfg) as f: data = json.load(f)
except Exception:
    data = {}
data.setdefault("$schema", "https://opencode.ai/config.json")
store = os.environ["SRC"]
paths = sorted(glob.glob(os.path.join(store, "*", "SKILL.md")))
instr = data.setdefault("instructions", [])
# Drop entries under fxlla's own store that no longer exist (a renamed or removed
# skill), and leave every other entry the user configured untouched.
prefix = store.rstrip(os.sep) + os.sep
kept = [i for i in instr if not (isinstance(i, str) and i.startswith(prefix)) or i in paths]
for p in paths:
    if p not in kept:
        kept.append(p)
data["instructions"] = kept
with open(cfg, "w") as f: json.dump(data, f, indent=2)
print(cfg)
PY
  ok "opencode instructions updated: $cfg"
}

# Register the gateway's models under the opencode 'local' provider. The list
# arrives on MODEL_IDS (newline-separated) from the gateway's own /v1/models,
# which is the single place that decides what is chat-servable - it already
# excludes embedding models, and enumerating the store here again would
# re-add them (that bug shipped: 'embed' spent days registered as a chat
# model in opencode). An empty list leaves the existing models untouched
# rather than wiping the provider over a transient fetch failure.
_sync_opencode_all() {
  local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json"
  mkdir -p "$(dirname "$cfg")"
  BASE_URL="$BASE_URL" MODEL_IDS="${MODEL_IDS:-}" CFG="$cfg" python3 - <<'PY'
import os, json
cfg = os.environ["CFG"]
try:
    with open(cfg) as f: data = json.load(f)
except Exception:
    data = {}
data.setdefault("$schema", "https://opencode.ai/config.json")
loc = data.setdefault("provider", {}).setdefault("local", {})
loc["npm"] = "@ai-sdk/openai-compatible"
loc["name"] = "Local (fxlla gateway)"
opts = loc.setdefault("options", {})
opts["baseURL"] = os.environ["BASE_URL"]
# No key is validated locally; without one opencode prompts the user for it.
opts.setdefault("apiKey", "local")
models = {}
for line in os.environ.get("MODEL_IDS", "").splitlines():
    if not line.strip():
        continue
    parts = line.split("\t")
    mid = parts[0].strip()
    entry = {"name": "%s (local)" % mid}
    ctx = parts[1].strip() if len(parts) > 1 else ""
    if ctx.isdigit():
        # Without a declared limit opencode's context meter and its
        # auto-compaction trigger run on a made-up number. Output is at
        # least a real completion (4k) and at most a quarter of the
        # window, capped at 16k.
        n = int(ctx)
        entry["limit"] = {"context": n,
                          "output": max(4096, min(16384, n // 4))}
    models[mid] = entry
if models:
    loc["models"] = dict(sorted(models.items()))
else:
    loc.setdefault("models", {})
with open(cfg, "w") as f: json.dump(data, f, indent=2)
PY
}

# --------------------------------------------------------------------------
# multi-model gateway: one endpoint routing to per-model backends on demand
cmd_serve() {
  need python3; require_store
  server_alive && die "A single-model server is running on $FXLLA_PORT. Run 'fxlla off' first."
  if gateway_alive; then warn "Gateway already running (pid $(gateway_pid))."; return 1; fi
  info "Starting gateway at $BASE_URL (multi-model, on-demand load + LRU eviction)..."
  # Settings the gateway reads but that are NOT in the assignment list below.
  # config.env is sourced into plain shell variables, never exported, and the
  # launch line passes an explicit allowlist - so a setting the gateway reads
  # and this list forgets is silently ignored. Four were: FXLLA_LOOP_LIMIT and
  # the three vision knobs. Measured, not assumed: FXLLA_LOOP_LIMIT=3 in
  # config.env left the gateway refusing at 8.
  #
  # Exported only when actually set, because empty is not the same as absent
  # here - FXLLA_VISION_ROUTING="" reads as OFF, so passing it unconditionally
  # would have disabled image routing for everyone.
  # `tests/test_wire.sh` asserts this list against what the gateway reads.
  local _v
  for _v in FXLLA_LOOP_LIMIT FXLLA_VISION_ROUTING FXLLA_VISION_MODEL \
            FXLLA_VISION_MAX_IMAGES; do
    [ -n "${!_v:-}" ] && export "${_v?}"
  done
  FXLLA_HOST="$FXLLA_HOST" FXLLA_PORT="$FXLLA_PORT" FXLLA_STORE="$FXLLA_STORE" \
    FXLLA_BACKEND_PORT_BASE="${FXLLA_BACKEND_PORT_BASE:-8100}" \
    FXLLA_GATEWAY_BUDGET_MB="${FXLLA_GATEWAY_BUDGET_MB:-}" \
    FXLLA_STATS_FILE="$STATS_FILE" \
    FXLLA_CTX="$FXLLA_CTX" \
    FXLLA_KEEP_WARM="$FXLLA_KEEP_WARM" \
    FXLLA_ROPE_STRETCH="${FXLLA_ROPE_STRETCH:-0}" \
    FXLLA_BIN="$SELF" \
    nohup python3 "$REPO_ROOT/gateway/fxlla_gateway.py" > "$GATEWAY_LOG" 2>&1 &
  echo $! > "$GATEWAY_PID"
  local _ ids health
  for _ in $(seq 1 30); do
    # An answer on /health says something is listening, NOT that it is ours.
    # llama-server answers /health too, so a stale single-model server squatting
    # the port made the gateway die on bind while this loop read the squatter's
    # reply and announced "Gateway up", listing the intruder's one model.
    #
    # Checking our own pid first is not enough on its own - the child is still
    # alive for the moment between spawn and its bind failing, which is inside
    # this loop's first pass. So identify the RESPONDER: budget_mb is a field
    # only this gateway puts in /health. Both checks stay, because they catch
    # different things - a foreign listener, and our own process dying later.
    gateway_alive || {
      warn "Gateway died on start:"; tail -n 20 "$GATEWAY_LOG" >&2
      rm -f "$GATEWAY_PID"; return 1
    }
    health="$(curl -sf "http://$FXLLA_HOST:$FXLLA_PORT/health" 2>/dev/null || true)"
    case "$health" in
      *'"budget_mb"'*) ;;   # ours
      *) health="" ;;       # someone else's, or nothing yet
    esac
    if [ -n "$health" ]; then
      # One fetch feeds both the banner and the opencode registration, so what
      # the user reads is exactly what got registered. Lines are "id<TAB>ctx";
      # the context travels so opencode's meter runs on the real window.
      ids="$(curl -s "http://$FXLLA_HOST:$FXLLA_PORT/v1/models" \
        | python3 -c 'import sys,json
for m in json.load(sys.stdin)["data"]:
    print("%s\t%s" % (m["id"], m.get("context") or ""))' 2>/dev/null || true)"
      MODEL_IDS="$ids" _sync_opencode_all
      ok "Gateway up at $BASE_URL"
      info "Models: $(printf '%s' "$ids" | cut -f1 | tr '\n' ',' | sed 's/,$//;s/,/, /g')"
      ok "In opencode: provider 'local', pick any model. The first request loads it."
      return 0
    fi
    sleep 1
  done
  warn "Gateway not ready in time. Check: tail -f $GATEWAY_LOG"; return 1
}

cmd_unserve() {
  if gateway_alive; then
    local p; p="$(gateway_pid)"
    kill "$p" 2>/dev/null || true; sleep 2
    kill -0 "$p" 2>/dev/null && kill -9 "$p" 2>/dev/null || true
    rm -f "$GATEWAY_PID"
    ok "Gateway stopped (backends unloaded)."
  else
    warn "No gateway running."; rm -f "$GATEWAY_PID"
  fi
}

# internal: run one model server in the foreground on a port (spawned by the gateway)
# The llama-server flags derived from the weights themselves, in the ONE place
# that decides them. There were two copies of this launch - the gateway's
# backend and `fxlla on` - and they had already drifted: the second never
# passed the projector, so a vision model started with `fxlla on` served
# text-only and dropped every image, and it never got the trained context
# window, the rope-scaling override or MTP speculation either. Echoes a flag
# string; the caller word-splits it deliberately.
_llama_flags() {
  local dest="$1" mm="" f16="" p ctx="$FXLLA_CTX" rope_off=0 mtp=0 derived
  # Unanchored AND case-insensitive, because the pull side is both and the two
  # have to agree about what a projector is. Publishers disagree about where
  # the word goes - empero-ai ships `mmproj-Qwythos-27B-F16.gguf`, mradermacher
  # ships `Qwen3.5-9B.mmproj-Q8_0.gguf` - and a glob is case-SENSITIVE, so a
  # `MMProj` spelling that `grep -i` downloaded happily would never be found
  # here. Downloading a projector and then never passing it is the same silent
  # text-only failure as not downloading it, arrived at from the other side.
  #
  # C collation on purpose: gateway/ggufmeta.py picks the weights out of the
  # same directory with Python's sorted(), which is codepoint order. Two
  # orderings over one directory is two answers to "which file is the model".
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    case "$(printf '%s' "$p" | LC_ALL=C tr '[:upper:]' '[:lower:]')" in *f16*) [ -z "$f16" ] && f16="$p" ;; esac
    [ -z "$mm" ] && mm="$p"
  done <<EOF
$(
  # shellcheck disable=SC2012  # ls, not find: the point is LC_ALL=C sort, one
  # fixed order over this directory. Bash glob order is locale-collated and
  # python's sorted() is codepoint order, and when those two disagreed about
  # the same directory the launcher and the gateway picked different files.
  ls -1 "$dest" 2>/dev/null | LC_ALL=C sort | grep -i '\.gguf$' | grep -i 'mmproj' || true
)
EOF
  # f16 wins where a repo ships both: the projector is small and it is better.
  [ -n "$f16" ] && mm="$f16"
  [ -n "$mm" ] && mm="$dest/$mm"
  derived="$(python3 "$REPO_ROOT/gateway/ggufmeta.py" "$dest" "${FXLLA_CTX:-0}" "${FXLLA_ROPE_STRETCH:-0}" 2>/dev/null || true)"
  if [ -n "$derived" ]; then
    # shellcheck disable=SC2086  # three fields, read positionally
    set -- $derived
    ctx="$1"; rope_off="$2"; mtp="$3"
  fi
  printf -- '-c %s' "$ctx"
  # Below the trained window a baked-in rope stretch is pure loss, and
  # llama.cpp applies it at every size unless told not to.
  [ "$rope_off" = 1 ] && printf -- ' --rope-scaling none'
  # Only when the head is in the file. FXLLA_SPEC_MTP=0 turns it off for a
  # llama-server too old to know the flag, which otherwise exits at startup.
  [ "$mtp" = 1 ] && [ "${FXLLA_SPEC_MTP:-1}" != 0 ] && printf -- ' --spec-type draft-mtp'
  [ -n "$mm" ] && printf -- ' --mmproj %s' "$mm"
  printf '\n'
}

cmd_backend() {
  require_store
  local q="${1:-}" port="${2:-}"
  [ -n "$q" ] && [ -n "$port" ] || die "usage: fxlla _backend <alias> <port>"
  local name; name="$(local_name "$q")"
  local dest="$MODELS_DIR/$name"
  [ -d "$dest" ] || die "not downloaded: $name"
  local engine=mlx; [ -f "$dest/.engine" ] && engine="$(cat "$dest/.engine")"
  if [ "$engine" = gguf ]; then
    local entry; entry="$(cat "$dest/.entry" 2>/dev/null || true)"
    # The fallback for a directory with no .entry took the first .gguf in glob
    # order and excluded nothing, so a projector could be served AS the model.
    # It needs the exclusion the pull-side selection has: under a UTF-8 locale
    # `Qwen3.5-9B.mmproj-f16.gguf` collates before `Qwen3.5-9B.Q6_K.gguf`, so
    # this is the ordinary case for that publisher, not a corner of one.
    #
    # Case-insensitive and C-collated, for the two reasons _llama_flags gives:
    # `grep -i` on the pull side will accept a `MMProj` spelling this must also
    # reject, and gateway/ggufmeta.py reads the same directory with Python's
    # sorted(). One directory has to have one answer.
    if [ -z "$entry" ]; then
      # shellcheck disable=SC2012  # ls for the LC_ALL=C ordering, see above.
      entry="$(ls -1 "$dest" 2>/dev/null | LC_ALL=C sort \
               | grep -i '\.gguf$' | grep -iv 'mmproj' | head -1 || true)"
    fi
    [ -z "$entry" ] && die "No .gguf found in $dest"
    # A multimodal projector beside the weights makes this a vision model, and
    # llama-server needs it named: without --mmproj the same weights serve as
    # text-only and every image in a request is dropped. Discovered from disk
    # rather than declared, the way .entry already is. f16 preferred where the
    # repo ships both - the projector is small and it is the better one.
    # shellcheck disable=SC2046,SC2086  # the derived flags are meant to split
    exec llama-server --model "$dest/$entry" --alias "$name" --host 127.0.0.1 --port "$port" -ngl "$FXLLA_NGL" $(_llama_flags "$dest") --jinja $FXLLA_SERVER_ARGS
  elif [ "$engine" = omlx ]; then
    # omlx often lives in a venv rather than on PATH (its build pins mlx 0.32.0,
    # so it is kept isolated). FXLLA_OMLX_BIN points at that binary; command -v
    # accepts an absolute path, so `need` still validates it.
    local omlx_bin="${FXLLA_OMLX_BIN:-omlx}"
    need "$omlx_bin"
    # omlx serves the ONE model in --model-dir when the dir is itself a model
    # (config.json at the root, no model subdirs): discover_models registers it
    # under the directory basename, which is exactly "$name", so the gateway
    # sends the bare alias as the model field (see model_field_from). Three
    # flags are not optional here:
    #   --memory-guard off  omlx's own guard sizes a ceiling from total machine
    #     RAM with no view of the sibling backends the gateway also runs, so it
    #     would second-guess the gateway's budget and reject prefills it had
    #     already admitted. The gateway owns memory; omlx must not also.
    #   --base-path         omlx's settings.json is a non-atomic rewrite and its
    #     SSD prefix cache is thread- not process-safe, so every concurrent
    #     backend needs its own state dir or they race the shared ~/.omlx.
    #   --no-hf-cache       omlx otherwise enumerates the whole Hugging Face
    #     cache into /v1/models alongside our one model (measured). fxlla routes
    #     by the alias so it never mattered for correctness, but it is noise the
    #     gateway should not see - keep omlx to the model we handed it.
    # The SSD prefix cache is the reason to reach for omlx at all: a reused
    # prefix is restored from disk instead of a 60-80s recompute, and it
    # survives the backend being unloaded. Passed EXPLICITLY rather than left to
    # a default: omlx's help calls --paged-ssd-cache-dir the flag that "enables"
    # the cache, so naming it removes any doubt the feature is on.
    local base="${FXLLA_OMLX_BASE:-$MODELS_DIR/.omlx/$name}"
    # shellcheck disable=SC2086
    exec "$omlx_bin" serve --model-dir "$dest" --host 127.0.0.1 --port "$port" \
      --base-path "$base" \
      --memory-guard off \
      --no-hf-cache \
      --paged-ssd-cache-dir "$base/cache" \
      --paged-ssd-cache-max-size "${FXLLA_OMLX_CACHE_MAX:-20GB}" \
      $FXLLA_SERVER_ARGS
  elif [ "$engine" = mtplx ]; then
    # MTPLX is a second venv-pinned MLX server (native MTP speculative decode,
    # no external drafter), so FXLLA_MTPLX_BIN points at it the way omlx's does.
    # The model field is not validated (single model), so the gateway sends the
    # bare alias. --mtp forces speculation, --no-auth because the gateway is the
    # only caller, --yes to skip the interactive onboarding. --mtp also turns on
    # MTPLX's own SSD session cache, which defaults to 100GB and would fill a
    # disk: cap it and give it a per-model dir (its index is thread- not
    # process-safe across instances, the same reason omlx gets its own base).
    # A dedicated args var, not FXLLA_SERVER_ARGS: mtplx uses strict argparse and
    # would reject an mlx_lm/llama-server flag that the shared var might carry.
    local mtplx_bin="${FXLLA_MTPLX_BIN:-mtplx}"
    need "$mtplx_bin"
    local mbase="${FXLLA_MTPLX_BASE:-$MODELS_DIR/.mtplx/$name}"
    # shellcheck disable=SC2086
    exec "$mtplx_bin" serve --model "$dest" --host 127.0.0.1 --port "$port" \
      --no-auth --yes --mtp \
      --ssd-session-cache on \
      --ssd-session-cache-dir "$mbase/cache" \
      --ssd-session-cache-max-size "${FXLLA_MTPLX_CACHE_MAX:-20GB}" \
      $FXLLA_MTPLX_ARGS
  else
    # shellcheck disable=SC2086
    exec mlx_lm.server --model "$dest" --host 127.0.0.1 --port "$port" $FXLLA_SERVER_ARGS
  fi
}

# Score chat models on quality (mechanical checks) and speed (streamed probes).
# The shell owns catalog, cache, RAM and coexistence policy; evals/run.py owns
# everything measured. One "alias|dest|engine|size_mb|role" line per model goes
# to run.py on stdin.
cmd_eval() {
  need python3; require_store
  local fwd=() names=() list_only=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --dim|--tasks|--repeats)       fwd+=("$1" "${2:?missing value for $1}"); shift ;;
      --dim=*|--tasks=*|--repeats=*) fwd+=("$1") ;;
      --list)                        list_only=1; fwd+=("$1") ;;
      --quick|--json|--keep-failed)  fwd+=("$1") ;;
      -*) die "unknown flag: $1" ;;
      *)  names+=("$1") ;;
    esac; shift
  done

  # A non-numeric FXLLA_CTX would make the raise below a silent no-op (the
  # numeric test errors, the if treats that as false) and the context tasks
  # would fail for capacity while looking like failed recall.
  case "${FXLLA_CTX:-8192}" in
    ''|*[!0-9]*) die "FXLLA_CTX must be a plain integer (got '${FXLLA_CTX:-}')" ;;
  esac

  # --list only shows the plan: it must neither refuse for a busy server nor
  # unload anyone's gateway models.
  if [ "$list_only" = 0 ]; then
    # Speed numbers need the machine to itself. A single-model server cannot
    # be taken over safely, so that refuses; the gateway has an unload
    # endpoint built for exactly this (the media path uses it), so that
    # proceeds. Chatter goes to stderr: stdout belongs to run.py's report,
    # which --json turns into parseable JSON.
    server_alive && die "A server is running (pid $(server_pid)). Run 'fxlla off' first: the eval needs the GPU to itself for honest speed numbers."
    if gateway_alive; then
      local freed
      freed="$(curl -s -m 10 -X POST -H 'Content-Type: application/json' -d '{}' \
        "http://$FXLLA_HOST:$FXLLA_PORT/admin/unload" 2>/dev/null \
        | python3 -c 'import json,sys
try:
    print(", ".join(json.load(sys.stdin).get("unloaded") or []))
except Exception:
    pass' || true)"
      [ -n "$freed" ] && info "Freed gateway models for the eval: $freed (they reload on demand)." >&2
      warn "The gateway is up. Traffic arriving mid-eval reloads models and poisons the speed numbers."
    fi
    # The context tasks carry ~8k and ~16k token prompts; a gguf server
    # started at the 8192 default would truncate them and fail recall for
    # capacity.
    if [ "${FXLLA_CTX:-8192}" -lt 20480 ]; then
      info "Raising FXLLA_CTX to 20480 for this run (context tasks need it)." >&2
      export FXLLA_CTX=20480
    fi
  fi

  # Effective wired limit, same math as _ram_check, minus headroom: KV cache at
  # 20k context plus Metal buffers sit on top of the weights, so a model that
  # fits by file size can still wire past the limit mid-task. Skipping is for
  # the unattended default sweep only - naming a model runs it after a warning.
  local total_mb cur eff headroom=8192
  total_mb=$(( $(sysctl -n hw.memsize) / 1048576 ))
  cur="$(sysctl -n iogpu.wired_limit_mb 2>/dev/null || echo 0)"
  eff="$cur"; [ "$cur" = 0 ] && eff=$(( total_mb * 3 / 4 ))

  local plan="" alias dest engine size_mb role line
  if [ "${#names[@]}" -gt 0 ]; then
    local q
    for q in "${names[@]}"; do
      alias="$(local_name "$q")"
      dest="$MODELS_DIR/$alias"
      [ -f "$dest/.source" ] || die "'$alias' is not downloaded. Run: fxlla pull $q"
      engine=mlx; [ -f "$dest/.engine" ] && engine="$(cat "$dest/.engine")"
      role="$(_catalog_field "$q" 4 2>/dev/null || echo '-')"
      if [ "$role" = "-" ]; then
        # Pulled by org/repo: the alias is not in the catalog, but the repo it
        # came from may be. Identify by .source so 'fxlla eval nomic-.../...'
        # cannot slip an embedding model past the role check.
        local src crole=""
        src="$(trim "$(cat "$dest/.source" 2>/dev/null || true)")"
        [ -n "$src" ] && crole="$(trim "$(grep -F "$src" "$CATALOG" 2>/dev/null | grep -v '^#' | head -1 | cut -d'|' -f4 || true)")"
        [ -n "$crole" ] && role="$crole"
      fi
      [ "$role" = embed ] && die "'$alias' is an embedding model; 'fxlla kb eval' scores those."
      size_mb=$(( $(du -sk "$dest" 2>/dev/null | cut -f1) / 1024 ))
      if [ "$size_mb" -gt $(( eff - headroom )) ]; then
        warn "'$alias' (~${size_mb} MB) may not fit the GPU limit (~${eff} MB minus ${headroom} MB headroom). Running anyway since you named it; 'fxlla ram auto' raises the limit."
      fi
      plan="${plan}${alias}|${dest}|${engine}|${size_mb}|${role}
"
    done
  else
    while IFS= read -r line; do
      case "$line" in \#*|'') continue ;; esac
      alias="$(trim "$(echo "$line" | cut -d'|' -f1)")"
      role="$(trim "$(echo "$line" | cut -d'|' -f4)")"
      case "$role" in dev|agentic|max) ;; *) continue ;; esac
      dest="$MODELS_DIR/$alias"
      [ -f "$dest/.source" ] || continue
      engine=mlx; [ -f "$dest/.engine" ] && engine="$(cat "$dest/.engine")"
      size_mb=$(( $(du -sk "$dest" 2>/dev/null | cut -f1) / 1024 ))
      if [ "$size_mb" -gt $(( eff - headroom )) ]; then
        warn "Skipping '$alias' (~${size_mb} MB): over the GPU limit (~${eff} MB minus ${headroom} MB headroom). Raise it with 'fxlla ram auto', or name it explicitly to run anyway."
        continue
      fi
      plan="${plan}${alias}|${dest}|${engine}|${size_mb}|${role}
"
    done < "$CATALOG"
  fi

  mkdir -p "$STATE_DIR/evals"
  printf '%s' "$plan" | \
    FXLLA_BIN="$REPO_ROOT/bin/fxlla" \
    FXLLA_EVAL_PORT="${FXLLA_EVAL_PORT:-8097}" \
    FXLLA_EVAL_DIR="$STATE_DIR/evals" \
    FXLLA_STORE="$FXLLA_STORE" \
    python3 "$REPO_ROOT/evals/run.py" ${fwd[@]+"${fwd[@]}"}
}

# --------------------------------------------------------------------------
cmd_on() {
  require_store
  local q="" force_engine="" do_pull=0 assume=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --mlx) force_engine=mlx ;;
      --gguf) force_engine=gguf ;;
      --omlx) force_engine=omlx ;;
      --mtplx) force_engine=mtplx ;;
      --pull) do_pull=1 ;;
      --yes|-y) assume=1 ;;
      -*) die "unknown flag: $1" ;;
      *) q="$1" ;;
    esac; shift
  done
  [ -z "$q" ] && q="$FXLLA_DEFAULT_MODEL"
  local name; name="$(local_name "$q")"
  local dest="$MODELS_DIR/$name"
  if [ ! -f "$dest/.source" ]; then
    # Fail fast by default; only download when the caller opts in with --pull.
    if [ "$do_pull" = 1 ]; then
      info "'$name' is not cached; pulling (opt-in via --pull)..."
      local pull_args=("$q")
      [ "$assume" = 1 ] && pull_args+=(--yes)
      cmd_pull "${pull_args[@]}" || die "pull failed for '$q'"
    else
      die "'$name' is not downloaded. Run: fxlla pull $q   (or: fxlla on $q --pull)"
    fi
  fi

  local engine="$force_engine"
  [ -z "$engine" ] && [ -f "$dest/.engine" ] && engine="$(cat "$dest/.engine")"
  [ -z "$engine" ] && engine=mlx

  gateway_alive && die "The gateway is running on $FXLLA_PORT. Use it (it loads models on demand), or run 'fxlla unserve' first."
  server_alive && { warn "A server is already running (pid $(server_pid)). Run 'fxlla off' first."; return 1; }

  # warn if the model does not fit the current RAM limit
  _ram_check "$dest"

  if [ "$engine" = gguf ]; then
    need llama-server
    local entry; entry="$(cat "$dest/.entry" 2>/dev/null || true)"
    if [ -z "$entry" ]; then
      local f
      for f in "$dest"/*.gguf; do [ -e "$f" ] && { entry="$(basename "$f")"; break; }; done
    fi
    [ -z "$entry" ] && die "No .gguf found in $dest"
    info "Starting $name (gguf/llama.cpp) at $BASE_URL ..."
    # shellcheck disable=SC2046,SC2086  # the derived flags are meant to split
    nohup llama-server --model "$dest/$entry" --alias "$name" \
      --host "$FXLLA_HOST" --port "$FXLLA_PORT" -ngl "$FXLLA_NGL" \
      $(_llama_flags "$dest") --jinja \
      $FXLLA_SERVER_ARGS > "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
  elif [ "$engine" = omlx ]; then
    local omlx_bin="${FXLLA_OMLX_BIN:-omlx}"
    need "$omlx_bin"
    info "Starting $name (omlx) at $BASE_URL ..."
    # Mirrors cmd_backend's omlx launch; see the rationale for the flags there.
    # This second launch site has drifted from cmd_backend before, so keep the
    # two in step.
    local base="${FXLLA_OMLX_BASE:-$MODELS_DIR/.omlx/$name}"
    # shellcheck disable=SC2086
    nohup "$omlx_bin" serve --model-dir "$dest" --host "$FXLLA_HOST" --port "$FXLLA_PORT" \
      --base-path "$base" \
      --memory-guard off \
      --no-hf-cache \
      --paged-ssd-cache-dir "$base/cache" \
      --paged-ssd-cache-max-size "${FXLLA_OMLX_CACHE_MAX:-20GB}" \
      $FXLLA_SERVER_ARGS > "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
  elif [ "$engine" = mtplx ]; then
    local mtplx_bin="${FXLLA_MTPLX_BIN:-mtplx}"
    need "$mtplx_bin"
    info "Starting $name (mtplx) at $BASE_URL ..."
    # Mirrors cmd_backend's mtplx launch; see the rationale for the flags there.
    local mbase="${FXLLA_MTPLX_BASE:-$MODELS_DIR/.mtplx/$name}"
    # shellcheck disable=SC2086
    nohup "$mtplx_bin" serve --model "$dest" --host "$FXLLA_HOST" --port "$FXLLA_PORT" \
      --no-auth --yes --mtp \
      --ssd-session-cache on \
      --ssd-session-cache-dir "$mbase/cache" \
      --ssd-session-cache-max-size "${FXLLA_MTPLX_CACHE_MAX:-20GB}" \
      $FXLLA_MTPLX_ARGS > "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
  else
    need mlx_lm.server
    info "Starting $name (mlx) at $BASE_URL ..."
    # shellcheck disable=SC2086
    nohup mlx_lm.server --model "$dest" --host "$FXLLA_HOST" --port "$FXLLA_PORT" \
      $FXLLA_SERVER_ARGS > "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
  fi

  # The id to register is the one this server accepts for the model we just
  # loaded, and it differs by engine: llama-server is started with
  # --alias "$name", while mlx_lm.server takes the model path. Do not read it
  # from /v1/models: mlx_lm enumerates the whole Hugging Face cache there, so the
  # first entry is whatever unrelated model happens to sort first - which
  # silently registered a diffusion model as the local chat model in opencode.
  local id
  case "$engine" in
    gguf) id="$name" ;;
    omlx) id="$name" ;;   # omlx serves the model under its directory basename
    mtplx) id="$name" ;;  # mtplx is a single-model server, accepts any model field
    *)    id="$dest" ;;
  esac
  for _ in $(seq 1 90); do
    if curl -sf "$BASE_URL/models" >/dev/null 2>&1; then
      echo "$name|$id|$engine" > "$CURRENT_FILE"
      touch "$ACT_FILE"
      _sync_opencode "$id" "$name (local)" >/dev/null
      _start_watchdog
      ok "Up: '$name' ($engine) at $BASE_URL"
      [ "${FXLLA_KEEP_WARM:-0}" -gt 0 ] && info "Auto-stops after ${FXLLA_KEEP_WARM} idle min."
      ok "In opencode: provider 'local'. Claude Code untouched."
      return 0
    fi
    server_alive || { warn "The server died on start:"; tail -n 25 "$LOG_FILE" >&2; rm -f "$PID_FILE"; return 1; }
    sleep 1
  done
  warn "No response in time. Check: fxlla logs"; return 1
}

# non-blocking warning if the model exceeds the GPU RAM limit
_ram_check() {
  local dest="$1" total_mb cur eff size_mb
  total_mb=$(( $(sysctl -n hw.memsize) / 1048576 ))
  cur="$(sysctl -n iogpu.wired_limit_mb 2>/dev/null || echo 0)"
  eff="$cur"; [ "$cur" = 0 ] && eff="$(( total_mb * 3 / 4 ))"
  size_mb=$(( $(du -sk "$dest" 2>/dev/null | cut -f1) / 1024 ))
  if [ "$size_mb" -gt "$eff" ]; then
    warn "This model is ~${size_mb} MB and the GPU can reserve ~${eff} MB now."
    warn "Raise the limit before loading it: fxlla ram auto"
  fi
}

cmd_off() {
  if [ -f "$WATCH_PID" ]; then kill "$(cat "$WATCH_PID")" 2>/dev/null || true; rm -f "$WATCH_PID"; fi
  if server_alive; then
    local p; p="$(server_pid)"
    kill "$p" 2>/dev/null || true; sleep 1
    kill -0 "$p" 2>/dev/null && kill -9 "$p" 2>/dev/null || true
    rm -f "$PID_FILE" "$CURRENT_FILE"
    ok "Server stopped."
  else
    warn "No server running."; rm -f "$PID_FILE"
  fi
}

cmd_status() {
  if gateway_alive; then
    ok "* Gateway running (pid $(gateway_pid)) at $BASE_URL"
    curl -s "http://$FXLLA_HOST:$FXLLA_PORT/health" 2>/dev/null | python3 -c 'import sys,json
d=json.load(sys.stdin)
r=d.get("resident",[])
print("  resident:", ", ".join("%s (%d MB, idle %ds)"%(b["alias"],b["size_mb"],b["idle_s"]) for b in r) or "(none loaded yet)")
print("  budget:", d.get("budget_mb"), "MB")
# A long first turn and a hung one look identical from outside, and the
# difference is the whole question when a client is showing a spinner.
for b in r:
    if not b.get("inflight"): continue
    secs = b.get("busy_s", 0)
    if b.get("phase") == "generating":
        detail = "generating, %s tokens written" % format(b.get("output_tokens", 0), ",")
    else:
        pt = b.get("prompt_tokens")
        detail = ("reading %s tokens of context" % format(pt, ",")) if pt else "reading the prompt"
    print("  working:  %s, %ds so far - %s" % (b["alias"], secs, detail))' 2>/dev/null || warn "  gateway not responding yet"
    return 0
  fi
  if server_alive; then
    ok "* Server running (pid $(server_pid))"
    if [ -f "$CURRENT_FILE" ]; then
      info "Model: $(cut -d'|' -f1 "$CURRENT_FILE")  |  engine: $(cut -d'|' -f3 "$CURRENT_FILE")"
    fi
    info "Endpoint: $BASE_URL"
    if [ -f "$ACT_FILE" ] && [ "${FXLLA_KEEP_WARM:-0}" -gt 0 ]; then
      local idle; idle=$(( $(date +%s) - $(stat -f %m "$ACT_FILE" 2>/dev/null || echo 0) ))
      info "Idle: $(( idle / 60 ))m $(( idle % 60 ))s  (auto-stop at ${FXLLA_KEEP_WARM}m)"
    fi
    if curl -sf "$BASE_URL/models" >/dev/null 2>&1; then ok "Responds OK"; else warn "Not responding yet"; fi
  else
    warn "Server stopped"
  fi
}

# measure time-to-first-token (ms) and decode rate (tok/s) with a tiny probe.
# prints "TTFT_MS TPS".
_probe() {
  BASE_URL="$BASE_URL" python3 - <<'PY'
import os, json, time, urllib.request
base = os.environ["BASE_URL"]
body = json.dumps({
    "messages": [{"role": "user", "content": "Reply with one short sentence."}],
    "max_tokens": 48, "stream": True, "temperature": 0,
}).encode()
req = urllib.request.Request(base + "/chat/completions", data=body,
                            headers={"Content-Type": "application/json"})
t0 = time.time(); tfirst = None; n = 0
try:
    r = urllib.request.urlopen(req, timeout=60)
    for raw in r:
        line = raw.decode("utf-8", "ignore").strip()
        if not line.startswith("data:"): continue
        data = line[5:].strip()
        if data == "[DONE]": break
        try: obj = json.loads(data)
        except Exception: continue
        # Count what the model GENERATED, not what a reader sees. A reasoning
        # model spends this whole 48-token budget thinking and emits no visible
        # content at all, so counting only `content` made this report a perfect
        # `0 0` - a plausible-looking zero that then lands in stats.jsonl and
        # gets charted. Servers disagree on the field: llama.cpp streams
        # `reasoning_content`, mlx_lm streams `reasoning`. gateway/metrics.py
        # carries the same list for the same reason; change both together.
        d = (obj.get("choices") or [{}])[0].get("delta", {}) or {}
        if any(d.get(k) for k in ("content", "reasoning_content", "reasoning")):
            if tfirst is None: tfirst = time.time()
            n += 1
    tend = time.time()
    ttft = int((tfirst - t0) * 1000) if tfirst else 0
    gen = (tend - tfirst) if tfirst else 0
    tps = round(n / gen, 1) if gen > 0 else 0
    print(f"{ttft} {tps}")
except Exception:
    print("0 0")
PY
}

_stats_once() {
  local json="$1" probe="$2"
  local pid model engine ram_kb ram_mb idle ttft tps ts sample
  pid="$(server_pid)"
  model="$(cut -d'|' -f1 "$CURRENT_FILE" 2>/dev/null || echo '?')"
  engine="$(cut -d'|' -f3 "$CURRENT_FILE" 2>/dev/null || echo '?')"
  ram_kb="$(ps -o rss= -p "$pid" 2>/dev/null | tr -d ' ')"; ram_mb=$(( ${ram_kb:-0} / 1024 ))
  idle=$(( $(date +%s) - $(stat -f %m "$ACT_FILE" 2>/dev/null || date +%s) ))
  ttft="null"; tps="null"
  if [ "$probe" = 1 ]; then read -r ttft tps < <(_probe); fi
  ts="$(date +%s)"
  sample="{\"ts\":$ts,\"model\":\"$model\",\"engine\":\"$engine\",\"ram_mb\":$ram_mb,\"ttft_ms\":$ttft,\"tps\":$tps,\"idle_s\":$idle}"
  echo "$sample" >> "$STATS_FILE"
  tail -n 5000 "$STATS_FILE" > "$STATS_FILE.tmp" 2>/dev/null && mv "$STATS_FILE.tmp" "$STATS_FILE"
  if [ "$json" = 1 ]; then
    echo "$sample"
  else
    printf "%-14s %-5s  RAM %5s MB  TTFT %5s ms  %6s tok/s  idle %ss\n" \
      "$model" "$engine" "$ram_mb" "$ttft" "$tps" "$idle"
  fi
}

# Format one stored JSONL sample for humans (or pass it through with --json).
_stats_fmt() {
  local line="$1" json="$2"
  [ -n "$line" ] || return 0
  if [ "$json" = 1 ]; then echo "$line"; return; fi
  python3 - "$line" <<'PY'
import json, sys
try:
    s = json.loads(sys.argv[1])
except Exception:
    sys.exit(0)
def g(k, d="-"):
    v = s.get(k)
    return d if v is None else v
print("%-14s %-5s  RAM %5s MB  TTFT %5s ms  %6s tok/s  (%s)" % (
    g("model"), g("engine"), g("ram_mb"), g("ttft_ms"), g("tps"), g("source", "probe")))
PY
}

# Read the passive time-series the gateway writes as it proxies real traffic.
_stats_passive() {
  local json="$1" watch="$2"
  [ -f "$STATS_FILE" ] || die "No samples yet. Send a request through the gateway on :$FXLLA_PORT."
  if [ "$watch" = 1 ]; then
    # -F (follow by name) reopens after _maybe_trim's atomic replace; -f would
    # keep following the old inode and stall silently once the file rotates.
    tail -n 1 -F "$STATS_FILE" | while IFS= read -r line; do _stats_fmt "$line" "$json"; done
  else
    local line; line="$(tail -n 1 "$STATS_FILE")"
    [ -n "$line" ] || die "No samples yet. Send a request through the gateway on :$FXLLA_PORT."
    _stats_fmt "$line" "$json"
  fi
}

cmd_stats() {
  local json=0 watch=0 interval=5 probe=1 last=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json)      json=1 ;;
      --watch)     watch=1 ;;
      --interval)  interval="$2"; shift ;;
      --no-probe)  probe=0 ;;
      --last)      last="$2"; shift ;;
      -*)          die "unknown flag: $1" ;;
    esac; shift
  done
  if [ -n "$last" ]; then
    # Dump the newest N recorded samples (history; no live server needed).
    # An explicit sentinel (empty = unset) so '--last 0' is a real error.
    case "$last" in 0|*[!0-9]*) die "--last needs a positive integer" ;; esac
    [ -f "$STATS_FILE" ] || die "No samples recorded yet."
    tail -n "$last" "$STATS_FILE" | while IFS= read -r line; do _stats_fmt "$line" "$json"; done
    return 0
  fi
  if server_alive; then
    # A single-model server: probe it directly for live tok/s and TTFT.
    if [ "$watch" = 1 ]; then
      while true; do _stats_once "$json" "$probe"; server_alive || break; sleep "$interval"; done
    else
      _stats_once "$json" "$probe"
    fi
  elif gateway_alive; then
    # The gateway records real traffic passively; read that time-series.
    _stats_passive "$json" "$watch"
  else
    die "No server running. Start one: fxlla on <model> (or fxlla serve)"
  fi
}

cmd_logs() { [ -f "$LOG_FILE" ] || die "No log yet."; tail -f "$LOG_FILE"; }

cmd_doctor() {
  local pass=0 warn=0 fail=0
  _chk() {
    case "$1" in
      ok)   pass=$((pass+1)); printf "  [ ok ] %s\n" "$2" ;;
      warn) warn=$((warn+1)); printf "  [warn] %s\n" "$2" ;;
      fail) fail=$((fail+1)); printf "  [FAIL] %s\n" "$2" ;;
    esac
  }

  info "Dependencies"
  local c
  for c in uv aria2c python3 curl; do
    if command -v "$c" >/dev/null 2>&1; then _chk ok "$c"; else _chk fail "$c missing (run: fxlla setup)"; fi
  done
  if command -v mlx_lm.server >/dev/null 2>&1; then _chk ok "mlx_lm.server (MLX engine)"; else _chk warn "mlx_lm.server missing (MLX; run: fxlla setup)"; fi
  if command -v llama-server >/dev/null 2>&1; then _chk ok "llama-server (GGUF engine)"; else _chk warn "llama-server missing (GGUF; run: fxlla setup)"; fi
  if command -v "${FXLLA_OMLX_BIN:-omlx}" >/dev/null 2>&1; then _chk ok "omlx (OMLX engine, optional): ${FXLLA_OMLX_BIN:-omlx}"; else _chk warn "omlx not found (optional 3rd engine, SSD KV cache). Install, or set FXLLA_OMLX_BIN to its venv path"; fi
  if command -v "${FXLLA_MTPLX_BIN:-mtplx}" >/dev/null 2>&1; then _chk ok "mtplx (MTPLX engine, optional): ${FXLLA_MTPLX_BIN:-mtplx}"; else _chk warn "mtplx not found (optional 4th engine, native MTP speculative decode). Install, or set FXLLA_MTPLX_BIN to its venv path"; fi

  info "Environment"
  if echo ":$PATH:" | grep -q ":$HOME/.local/bin:"; then _chk ok "$HOME/.local/bin on PATH"; else _chk warn "$HOME/.local/bin not on PATH (add it to your shell rc)"; fi

  info "Store"
  if [ -d "$FXLLA_STORE" ]; then
    # `df -Pk` rather than `df -g`: -g is a BSD spelling that GNU df rejects,
    # and rejecting it here does not degrade to "free space unknown" - the
    # pipeline fails, `set -e` fires on the assignment, and the whole doctor
    # exits mid-section having reported nothing. A diagnostic command is the
    # last place that should abort over a flag. `|| true` keeps it that way
    # even if some df disagrees about -P too.
    local free; free="$(df -Pk "$FXLLA_STORE" 2>/dev/null \
      | awk 'NR==2{printf "%d", $4/1048576}' || true)"
    local n; n="$(find "$MODELS_DIR" -maxdepth 1 -type d 2>/dev/null | grep -c . || true)"
    _chk ok "store mounted: $FXLLA_STORE (${free:-?} GB free, $(( n>0 ? n-1 : 0 )) models)"
  else
    _chk fail "store not found: $FXLLA_STORE (set FXLLA_STORE in ~/.config/fxlla/config.env)"
  fi
  local stray; stray="$(stray_model_dirs || true)"
  if [ -z "$stray" ]; then
    _chk ok "every downloaded model answers to its catalog alias"
  else
    local sdir salias
    while IFS="$(printf '\t')" read -r sdir salias; do
      [ -n "$sdir" ] || continue
      if [ -d "$MODELS_DIR/$salias" ]; then
        # Both names exist, so the same weights were fetched twice. `mv` here
        # would move one INSIDE the other rather than rename it, which is why
        # this case gets told apart instead of getting the same advice.
        _chk warn "'$salias' exists under both names - '$sdir' and '$salias' are two copies of the same model. Keep whichever is complete and delete the other:"
        printf "         du -sh %s %s\n" "$(shq "$MODELS_DIR/$sdir")" "$(shq "$MODELS_DIR/$salias")"
      else
        _chk warn "'$salias' is downloaded but named '$sdir', so the alias reports it missing. Rename it (nothing is re-downloaded):"
        printf "         mv %s %s\n" "$(shq "$MODELS_DIR/$sdir")" "$(shq "$MODELS_DIR/$salias")"
      fi
    done <<EOF
$stray
EOF
  fi

  info "GPU memory"
  local total_mb cur eff reserve rec
  total_mb=$(( $(sysctl -n hw.memsize) / 1048576 ))
  cur="$(sysctl -n iogpu.wired_limit_mb 2>/dev/null || echo 0)"
  reserve="${FXLLA_RAM_RESERVE_MB:-8192}"; rec=$(( total_mb - reserve ))
  if [ "$cur" = 0 ]; then
    eff=$(( total_mb * 3 / 4 ))
    _chk ok "GPU can reserve ~${eff} MB of ${total_mb} MB (macOS default; raise with: fxlla ram auto)"
  elif [ "$cur" -lt "$rec" ]; then
    _chk warn "GPU wired limit ${cur} MB is below recommended ${rec} MB (fxlla ram auto)"
  else
    _chk ok "GPU wired limit ${cur} MB of ${total_mb} MB"
  fi

  info "Media (optional)"
  # The image CLIs honor FXLLA_MFLUX_BIN_DIR; the doctor must look where the
  # generator will actually look, or it approves a PATH install the knob is
  # deliberately bypassing.
  if [ -n "${FXLLA_MFLUX_BIN_DIR:-}" ]; then
    if [ -x "$FXLLA_MFLUX_BIN_DIR/mflux-generate" ]; then
      _chk ok "mflux-generate (image, from FXLLA_MFLUX_BIN_DIR)"
    else
      _chk warn "FXLLA_MFLUX_BIN_DIR is set but has no mflux-generate: $FXLLA_MFLUX_BIN_DIR"
    fi
  elif command -v mflux-generate >/dev/null 2>&1; then
    _chk ok "mflux-generate (image)"
  else
    _chk warn "mflux-generate missing (image; run: fxlla setup --media)"
  fi
  if command -v "$FXLLA_VIDEO_BIN" >/dev/null 2>&1; then
    _chk ok "video backend: $FXLLA_VIDEO_BIN"
  else
    _chk warn "video backend not found: $FXLLA_VIDEO_BIN (set FXLLA_VIDEO_BIN)"
  fi
  # Ask generate.py which interpreter voice will actually use - resolution
  # lives there (env override, then the uv tool venv, then python3) and
  # re-implementing it here is how the two would drift.
  local _vp
  _vp="$(python3 "$REPO_ROOT/media/generate.py" voice-python 2>/dev/null || echo "${FXLLA_VOICE_PYTHON:-python3}")"
  if ! command -v "$_vp" >/dev/null 2>&1; then
    _chk warn "voice interpreter not found: $_vp (set FXLLA_VOICE_PYTHON)"
  elif "$_vp" -c 'import mlx_audio' >/dev/null 2>&1; then
    _chk ok "voice backend: $_vp has mlx-audio"
  else
    _chk warn "voice interpreter has no mlx-audio: $_vp (run: fxlla setup --media)"
  fi
  if command -v ffprobe >/dev/null 2>&1; then
    _chk ok "ffprobe present (video output is checked for frames)"
  else
    _chk warn "ffprobe not found (video output gets container checks only)"
  fi
  if [ -z "$FXLLA_MEDIA_HF_HOME" ]; then
    _chk warn "FXLLA_MEDIA_HF_HOME unset (using the default HF cache; set it to verify a path)"
  else
    # Several roots are allowed, ':' separated. Report each one on its own:
    # a list that is right except for one unmounted disk still loses every
    # model on that disk, and saying "media weight cache: <the whole list>"
    # would hide exactly that.
    local _root _first=1 _seen=0
    while IFS= read -r _root; do
      [ -n "$_root" ] || continue
      _seen=$((_seen + 1))
      local _label="searched"
      [ "$_first" = 1 ] && { _label="new downloads"; _first=0; }
      if [ -d "$_root" ]; then
        _chk ok "media weight cache ($_label): $_root"
      else
        # One message for both reasons it can be absent. Telling them apart by
        # whether the PARENT exists does not work: for a root that is itself a
        # volume mount point, the parent is /Volumes, which exists whether or
        # not the disk is attached - so an unmounted disk got reported as a
        # healthy empty cache, which is the worst of the three answers.
        _chk warn "media weight cache does not exist ($_label): $_root (created on the first download - if it lives on a disk, check that it is mounted)"
      fi
    done <<EOF
$(media_hf_roots)
EOF
    # Set, but nothing usable parsed out of it (a stray ':' on its own, or a
    # value built from an unset variable). Without this the loop above runs
    # zero times and the whole check disappears from the report, which reads
    # exactly like a check that passed.
    if [ "$_seen" -eq 0 ]; then
      _chk warn "FXLLA_MEDIA_HF_HOME is set but names no usable path: '$FXLLA_MEDIA_HF_HOME'"
    fi
  fi
  # Which catalog entries are ready, so a missing render dependency is visible
  # here instead of surfacing as a surprise download mid-job.
  if [ -f "$MEDIA_CATALOG" ]; then
    local mline mrepos mrepo mtotal=0 mcached=0
    while IFS= read -r mline; do
      case "$mline" in \#*|'') continue;; esac
      mrepos="$(trim "$(echo "$mline" | cut -d'|' -f2)")"
      mtotal=$((mtotal + 1))
      local ok_alias=1
      IFS=',' read -r -a _dl <<< "$mrepos"
      for mrepo in "${_dl[@]}"; do
        media_repo_cached "$mrepo" || { ok_alias=0; break; }
      done
      [ "$ok_alias" = 1 ] && mcached=$((mcached + 1))
    done < "$MEDIA_CATALOG"
    if [ "$mcached" -eq "$mtotal" ]; then
      _chk ok "media weights: $mcached/$mtotal cached"
    else
      _chk warn "media weights: $mcached/$mtotal cached (see: fxlla media weights)"
    fi
  fi

  # An installed skill that drifted from the repo keeps steering the model with
  # stale guidance, which is invisible unless something checks.
  info "Skills"
  local sdir stotal=0 scurrent=0 sname
  for sdir in "$REPO_ROOT/skills"/*/; do
    [ -f "$sdir/SKILL.md" ] || continue
    sname="$(basename "$sdir")"
    stotal=$((stotal + 1))
    [ "$(_skill_state "$sdir/SKILL.md" "$HOME/.claude/skills/$sname/SKILL.md")" = current ] \
      && scurrent=$((scurrent + 1))
  done
  if [ "$stotal" -eq 0 ]; then
    _chk warn "no skills found in $REPO_ROOT/skills"
  elif [ "$scurrent" -eq "$stotal" ]; then
    _chk ok "skills: $scurrent/$stotal installed and current (Claude Code)"
  else
    _chk warn "skills: $scurrent/$stotal current for Claude Code (run: fxlla skills install)"
  fi

  info "Server"
  if server_alive; then
    if curl -sf "$BASE_URL/models" >/dev/null 2>&1; then _chk ok "server up and responding ($BASE_URL)"; else _chk warn "server process alive but not responding yet"; fi
  else
    _chk ok "server stopped (idle)"
  fi

  unset -f _chk
  echo
  printf "Summary: %s ok, %s warn, %s fail\n" "$pass" "$warn" "$fail"
  [ "$fail" -gt 0 ] && return 1
  return 0
}

cmd_rm() {
  require_store
  local q="${1:-}"; [ -z "$q" ] && die "Usage: fxlla rm <alias|name>"
  local dest; dest="$MODELS_DIR/$(local_name "$q")"
  [ -d "$dest" ] || die "'$dest' does not exist."
  info "Deleting $dest ..."; rm -rf "$dest"; ok "Deleted."
}

# --------------------------------------------------------------------------
# Selects the python that runs rag/core.py. The sqlite-vec KNN index needs a
# python that can load sqlite extensions; the system python often cannot, so with
# FXLLA_KB_INDEX on we run under `uv run --with sqlite-vec` (uv is a hard dep).
# FXLLA_KB_PYTHON overrides with an explicit interpreter for advanced setups.
# Pure resolution: it never checks for uv, so wire-opencode can register the uv
# command on a machine where uv is only present at run time. Callers that execute
# KB_PY guard it with `_need_kb_uv`.
_kb_python() {
  if [ -n "${FXLLA_KB_PYTHON:-}" ]; then
    KB_PY=("$FXLLA_KB_PYTHON")
  elif is_true "${FXLLA_KB_INDEX:-}"; then
    KB_PY=(uv run --with sqlite-vec --no-project python)
  else
    KB_PY=(python3)
  fi
}

# Requires uv only when KB_PY actually runs under it (index on, no override).
_need_kb_uv() { [ "${KB_PY[0]}" = uv ] && need uv || true; }

# RAG knowledge bases (delegates to rag/core.py; MCP server for opencode/Claude)
cmd_kb() {
  need python3; require_store
  local KB_PY; _kb_python
  case "${1:-}" in
    # Run the MCP server under the kb python so its own core.py subprocess
    # (spawned via sys.executable) inherits sqlite-vec when the index is on.
    mcp)           _need_kb_uv
                   exec env FXLLA_STORE="$FXLLA_STORE" \
                     FXLLA_EMBED_PORT="${FXLLA_EMBED_PORT:-8090}" \
                     FXLLA_EMBED_MODEL="${FXLLA_EMBED_MODEL:-}" \
                     FXLLA_KB_INDEX="${FXLLA_KB_INDEX:-}" \
                     "${KB_PY[@]}" "$REPO_ROOT/rag/rag_mcp.py" ;;
    wire-opencode) _wire_rag_mcp; return ;;
    stop)          _kb_stop_embed; return ;;
  esac
  _need_kb_uv
  FXLLA_STORE="$FXLLA_STORE" FXLLA_EMBED_PORT="${FXLLA_EMBED_PORT:-8090}" \
  FXLLA_EMBED_MODEL="${FXLLA_EMBED_MODEL:-}" \
  FXLLA_KB_INDEX="${FXLLA_KB_INDEX:-}" \
    "${KB_PY[@]}" "$REPO_ROOT/rag/core.py" "$@"
}

# Stops the embedding server on FXLLA_EMBED_PORT. Reuse means a server outlives
# the command that started it - deliberately, when someone leaves one running to
# make queries fast, and accidentally when a CLI is killed mid-index - so there
# has to be a way to stop it that does not involve hunting for a pid.
_kb_stop_embed() {
  local port="${FXLLA_EMBED_PORT:-8090}" pids
  if ! curl -sf "http://127.0.0.1:$port/health" >/dev/null 2>&1; then
    info "No embedding server responding on port $port."
    return 0
  fi
  pids="$(lsof -ti "tcp:$port" -sTCP:LISTEN 2>/dev/null || true)"
  if [ -z "$pids" ]; then
    warn "Something answers on port $port but its process could not be found."
    return 1
  fi
  # shellcheck disable=SC2086  # deliberately word-split: there may be several
  kill $pids 2>/dev/null || true
  local _
  for _ in $(seq 1 40); do
    curl -sf "http://127.0.0.1:$port/health" >/dev/null 2>&1 || { ok "Stopped the embedding server on port $port."; return 0; }
    sleep 0.1
  done
  # shellcheck disable=SC2086
  kill -9 $pids 2>/dev/null || true
  ok "Stopped the embedding server on port $port."
}

# register the RAG MCP server in opencode's config
_wire_rag_mcp() {
  local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json"
  mkdir -p "$(dirname "$cfg")"
  local KB_PY; _kb_python
  CFG="$cfg" MCP="$REPO_ROOT/rag/rag_mcp.py" STORE="$FXLLA_STORE" \
  EMBED_PORT="${FXLLA_EMBED_PORT:-8090}" KB_INDEX="${FXLLA_KB_INDEX:-}" \
  EMBED_MODEL="${FXLLA_EMBED_MODEL:-}" \
  KB_PY_JSON="$(printf '%s\n' "${KB_PY[@]}" | python3 -c 'import json,sys; print(json.dumps([l.rstrip("\n") for l in sys.stdin]))')" \
  python3 - <<'PY'
import os, json
cfg = os.environ["CFG"]
try:
    with open(cfg) as f: data = json.load(f)
except Exception:
    data = {}
data.setdefault("$schema", "https://opencode.ai/config.json")
mcp = data.setdefault("mcp", {})
mcp["fxlla-rag"] = {
    "type": "local",
    "command": json.loads(os.environ["KB_PY_JSON"]) + [os.environ["MCP"]],
    "environment": {
        "FXLLA_STORE": os.environ["STORE"],
        "FXLLA_EMBED_PORT": os.environ["EMBED_PORT"],
        # Baked in like the rest: opencode launches rag_mcp.py directly, not
        # through `fxlla kb mcp`, so this registration is the only thing that
        # tells it which model. Left out, rag_search would embed with the
        # default while the base had been reindexed onto another.
        "FXLLA_EMBED_MODEL": os.environ["EMBED_MODEL"],
        "FXLLA_KB_INDEX": os.environ["KB_INDEX"],
    },
    "enabled": True,
}
with open(cfg, "w") as f: json.dump(data, f, indent=2)
print(cfg)
PY
  ok "RAG MCP registered in opencode. Use rag_search over your knowledge bases."
}

# Selects the python that runs the code graph. Its store is an embedded KuzuDB,
# which is not in the standard library, so by default we run under `uv run --with
# kuzu` (uv is a hard dep). FXLLA_GRAPH_PYTHON overrides with an interpreter that
# already has kuzu. GRAPH_PY is set as an array the caller can expand.
_graph_python() {
  if [ -n "${FXLLA_GRAPH_PYTHON:-}" ]; then
    GRAPH_PY=("$FXLLA_GRAPH_PYTHON")
  else
    # kuzu is the graph store; tree-sitter parses non-Python languages. kuzu is
    # pinned: upstream was archived after the Oct 2025 Apple acquisition and
    # 0.11.3 is the final release. Override with FXLLA_GRAPH_PYTHON if a
    # maintained fork/successor is adopted later.
    GRAPH_PY=(uv run --with "kuzu==0.11.3" --with tree-sitter
              --with tree-sitter-language-pack --no-project python)
  fi
}

# Requires uv only when GRAPH_PY actually runs under it (no override). Keeps
# wire-opencode able to register the uv command on a machine without uv present.
_need_graph_uv() { [ "${GRAPH_PY[0]}" = uv ] && need uv || true; }

# --------------------------------------------------------------------------
# Code graph (delegates to graph/codegraph.py; MCP server for opencode/Claude)
cmd_graph() {
  need python3; require_store
  local GRAPH_PY; _graph_python
  case "${1:-}" in
    # The MCP server re-invokes codegraph.py via its own interpreter, so it must
    # run under the same kuzu-capable python.
    mcp)           _need_graph_uv
                   exec env FXLLA_STORE="$FXLLA_STORE" "${GRAPH_PY[@]}" "$REPO_ROOT/graph/graph_mcp.py" ;;
    wire-opencode) _wire_graph_mcp; return ;;
  esac
  _need_graph_uv
  FXLLA_STORE="$FXLLA_STORE" "${GRAPH_PY[@]}" "$REPO_ROOT/graph/codegraph.py" "$@"
}

_wire_graph_mcp() {
  local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json"
  mkdir -p "$(dirname "$cfg")"
  local GRAPH_PY; _graph_python
  CFG="$cfg" MCP="$REPO_ROOT/graph/graph_mcp.py" STORE="$FXLLA_STORE" \
  GRAPH_PY_JSON="$(printf '%s\n' "${GRAPH_PY[@]}" | python3 -c 'import json,sys; print(json.dumps([l.rstrip("\n") for l in sys.stdin]))')" \
  python3 - <<'PY'
import os, json
cfg = os.environ["CFG"]
try:
    with open(cfg) as f: data = json.load(f)
except Exception:
    data = {}
data.setdefault("$schema", "https://opencode.ai/config.json")
mcp = data.setdefault("mcp", {})
mcp["fxlla-graph"] = {
    "type": "local",
    "command": json.loads(os.environ["GRAPH_PY_JSON"]) + [os.environ["MCP"]],
    "environment": {"FXLLA_STORE": os.environ["STORE"]},
    "enabled": True,
}
with open(cfg, "w") as f: json.dump(data, f, indent=2)
print(cfg)
PY
  ok "Code graph MCP registered in opencode. Use find_definition/find_references/find_callers."
}

# --------------------------------------------------------------------------
# Media: local image, video, and speech (delegates to media/generate.py; MCP)
# The FXLLA_* config the media toolchains read. Exported once so the direct
# call, the MCP server, and the opencode registration all forward the same set.
FXLLA_MEDIA_ENV="FXLLA_STORE FXLLA_MEDIA_HF_HOME FXLLA_MEDIA_MODEL FXLLA_MEDIA_OUT \
FXLLA_VIDEO_BIN FXLLA_LORA_DIRS FXLLA_VOICE_PYTHON FXLLA_VOICE_MODEL FXLLA_VOICE_REF FXLLA_VOICE_LANG \
FXLLA_HOST FXLLA_PORT FXLLA_MEDIA_KEEP_MODELS FXLLA_MEDIA_SKIP_QUALITY \
FXLLA_MCP_WAIT_S FXLLA_ASSUME_YES"

# What `fxlla do` reads on top of the media set: which model plans, and the
# two budgets. FXLLA_DEFAULT_MODEL is here because the planner falls back to it.
FXLLA_AGENT_ENV="FXLLA_AGENT_MODEL FXLLA_DEFAULT_MODEL \
FXLLA_AGENT_MAX_STEPS FXLLA_AGENT_MAX_SECONDS"

# One outcome in, one artifact out: fxlla plans, renders, looks at the result
# and retries once. It needs the media environment because it drives the same
# generators `fxlla media` does, and a running gateway because both the planner
# and the eyes are local models served by it.
cmd_do() {
  need python3; require_store
  # The media set plus the ones only the loop reads. config.env assigns with
  # `: "${VAR:=default}"`, which sets without exporting, so a name missing from
  # these lists never reaches the subprocess: FXLLA_AGENT_MODEL was documented
  # as the way to choose the planner and was being dropped on the floor, which
  # left every run on the hardcoded fallback with nothing saying so.
  # shellcheck disable=SC2086,SC2163  # export the names in the list, split on spaces
  export $FXLLA_MEDIA_ENV
  # shellcheck disable=SC2086,SC2163
  export $FXLLA_AGENT_ENV
  python3 "$REPO_ROOT/agent/loop.py" "$@"
}

cmd_media() {
  need python3; require_store
  # shellcheck disable=SC2086,SC2163  # export the names in the list, split on spaces
  export $FXLLA_MEDIA_ENV
  case "${1:-}" in
    mcp)           exec python3 "$REPO_ROOT/media/media_mcp.py" ;;
    wire-opencode) _wire_media_mcp; return ;;
    weights)       _media_weights; return ;;
  esac
  python3 "$REPO_ROOT/media/generate.py" "$@"
}

# register the media MCP server in opencode's config, forwarding the media env
_wire_media_mcp() {
  local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json"
  mkdir -p "$(dirname "$cfg")"
  # Export the set here rather than relying on the caller: config.env is read
  # with `: "${VAR:=default}"`, which assigns without exporting, so only
  # `fxlla media wire-opencode` (which exports on its way through cmd_media)
  # ever saw these. Through `wire-opencode --all` the registration got an
  # EMPTY environment, and every MCP media call died with "FXLLA_STORE is not
  # set" - which is what drove a real model off the tool and into shell.
  # shellcheck disable=SC2086,SC2163  # export the names in the list
  export $FXLLA_MEDIA_ENV
  CFG="$cfg" MCP="$REPO_ROOT/media/media_mcp.py" KEYS="$FXLLA_MEDIA_ENV" python3 - <<'PY'
import os, json
cfg = os.environ["CFG"]
try:
    with open(cfg) as f: data = json.load(f)
except Exception:
    data = {}
data.setdefault("$schema", "https://opencode.ai/config.json")
# Forward only the media vars that are actually set (drop FXLLA_MEDIA_OUT etc.
# when empty so the opencode config stays clean).
env = {k: os.environ[k] for k in os.environ["KEYS"].split() if os.environ.get(k)}
mcp = data.setdefault("mcp", {})
mcp["fxlla-media"] = {
    "type": "local",
    "command": ["python3", os.environ["MCP"]],
    "environment": env,
    "enabled": True,
}
with open(cfg, "w") as f: json.dump(data, f, indent=2)
print(cfg)
PY
  ok "Media MCP registered in opencode. Use generate_image/generate_video/generate_speech."
}

# --------------------------------------------------------------------------
# keep-warm: watchdog that auto-stops after N idle minutes with no requests
_start_watchdog() {
  [ "${FXLLA_KEEP_WARM:-0}" -gt 0 ] || return 0
  nohup "$SELF" __watch >/dev/null 2>&1 &
  echo $! > "$WATCH_PID"
}

cmd_watch() {
  local secs=$(( FXLLA_KEEP_WARM * 60 ))
  [ "$secs" -gt 0 ] || exit 0
  # mark activity on every request that shows up in the log
  ( tail -Fn0 "$LOG_FILE" 2>/dev/null | while IFS= read -r line; do
      case "$line" in *chat/completions*|*"/v1/"*|*"POST "*) touch "$ACT_FILE" 2>/dev/null || true;; esac
    done ) &
  local tailpid=$!
  trap 'kill $tailpid 2>/dev/null || true' EXIT
  while true; do
    sleep 30
    server_alive || exit 0
    local last now; last="$(stat -f %m "$ACT_FILE" 2>/dev/null || echo 0)"; now="$(date +%s)"
    if [ $(( now - last )) -ge "$secs" ]; then
      local p; p="$(server_pid)"
      [ -n "$p" ] && { kill "$p" 2>/dev/null || true; sleep 1; kill -9 "$p" 2>/dev/null || true; }
      rm -f "$PID_FILE" "$CURRENT_FILE" "$WATCH_PID"
      exit 0
    fi
  done
}

# --------------------------------------------------------------------------
# Shell completion. The generated bash/zsh scripts stay thin and call back into
# `fxlla __complete <what>` so the candidate lists live in one place here.
_complete_catalog() {
  grep -vE '^[[:space:]]*(#|$)' "$CATALOG" 2>/dev/null | cut -d'|' -f1 | awk 'NF{print $1}'
}

_complete_downloaded() {
  [ -d "$MODELS_DIR" ] || return 0
  local d
  for d in "$MODELS_DIR"/*/; do
    [ -f "$d/.source" ] || continue
    basename "$d"
  done
}

cmd_complete() {
  case "${1:-}" in
    commands)   printf '%s\n' setup models pull ls avail on off serve unserve \
                  status stats doctor logs ram eval kb graph media 'do' \
                  wire-opencode skills rm config completions help ;;
    catalog)    _complete_catalog ;;
    downloaded) _complete_downloaded ;;
    kb)         printf '%s\n' add search ls rm reindex eval stop mcp wire-opencode ;;
    graph)      printf '%s\n' index def refs callers impact unused stats ls rm \
                  mcp wire-opencode ;;
    media)      printf '%s\n' image video voice edit upscale models loras timings weights jobs job cancel mcp wire-opencode ;;
    skills)     printf '%s\n' install ls status ;;
  esac
}

cmd_completions() {
  case "${1:-}" in
    bash) cat <<'EOF'
# fxlla bash completion. Load with:  source <(fxlla completions bash)
# Candidates never contain spaces, and macOS ships bash 3.2 (no mapfile), so
# the classic word-splitting COMPREPLY assignment is used deliberately.
_fxlla_complete() {
  local cur cmd words
  cur="${COMP_WORDS[COMP_CWORD]}"
  cmd="${COMP_WORDS[1]:-}"
  if [ "$COMP_CWORD" -eq 1 ]; then
    # shellcheck disable=SC2207
    COMPREPLY=( $(compgen -W "$(fxlla __complete commands)" -- "$cur") )
    return
  fi
  words=""
  case "$cmd" in
    pull|get|avail|check)         words="$(fxlla __complete catalog)" ;;
    on|start|off|stop|rm|remove|eval)  words="$(fxlla __complete downloaded)" ;;
    kb)     [ "$COMP_CWORD" -eq 2 ] && words="$(fxlla __complete kb)" ;;
    graph)  [ "$COMP_CWORD" -eq 2 ] && words="$(fxlla __complete graph)" ;;
    media)  [ "$COMP_CWORD" -eq 2 ] && words="$(fxlla __complete media)" ;;
    skills) [ "$COMP_CWORD" -eq 2 ] && words="$(fxlla __complete skills)" ;;
    completions) words="bash zsh" ;;
  esac
  # shellcheck disable=SC2207
  COMPREPLY=( $(compgen -W "$words" -- "$cur") )
}
complete -F _fxlla_complete fxlla
EOF
      ;;
    zsh) cat <<'EOF'
#compdef fxlla
# fxlla zsh completion. Load with:  source <(fxlla completions zsh)
_fxlla() {
  local cmd="${words[2]}"
  if (( CURRENT == 2 )); then
    compadd -- ${(f)"$(fxlla __complete commands)"}
    return
  fi
  case "$cmd" in
    pull|get|avail|check)         compadd -- ${(f)"$(fxlla __complete catalog)"} ;;
    on|start|off|stop|rm|remove|eval)  compadd -- ${(f)"$(fxlla __complete downloaded)"} ;;
    kb)     (( CURRENT == 3 )) && compadd -- ${(f)"$(fxlla __complete kb)"} ;;
    graph)  (( CURRENT == 3 )) && compadd -- ${(f)"$(fxlla __complete graph)"} ;;
    media)  (( CURRENT == 3 )) && compadd -- ${(f)"$(fxlla __complete media)"} ;;
    skills) (( CURRENT == 3 )) && compadd -- ${(f)"$(fxlla __complete skills)"} ;;
    completions) compadd -- bash zsh ;;
  esac
}
compdef _fxlla fxlla
EOF
      ;;
    *) die "usage: fxlla completions <bash|zsh>" ;;
  esac
}

# --------------------------------------------------------------------------
main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    setup)                  cmd_setup "$@" ;;
    models|catalog)         cmd_models "$@" ;;
    pull|get)               cmd_pull "$@" ;;
    ls|list)                cmd_ls "$@" ;;
    avail|check)            cmd_avail "$@" ;;
    on|start)               cmd_on "$@" ;;
    off|stop)               cmd_off "$@" ;;
    serve)                  cmd_serve "$@" ;;
    unserve)                cmd_unserve "$@" ;;
    _backend)               cmd_backend "$@" ;;
    status|st)              cmd_status "$@" ;;
    stats)                  cmd_stats "$@" ;;
    doctor)                 cmd_doctor "$@" ;;
    logs|log)               cmd_logs "$@" ;;
    ram)                    cmd_ram "$@" ;;
    eval)                   cmd_eval "$@" ;;
    kb)                     cmd_kb "$@" ;;
    graph)                  cmd_graph "$@" ;;
    media)                  cmd_media "$@" ;;
    do)                     cmd_do "$@" ;;
    wire-opencode|opencode) cmd_wire_opencode "$@" ;;
    skills)                 cmd_skills "$@" ;;
    rm|remove)              cmd_rm "$@" ;;
    config)                 cmd_config "$@" ;;
    completions)            cmd_completions "$@" ;;
    __complete)             cmd_complete "$@" ;;
    __civitai-id)           _civitai_version_id "$@" || die "invalid civitai reference: ${1:-}" ;;
    __ram-plist)            _ram_plist_content "${1:-0}" ;;
    __watch)                cmd_watch ;;
    help|-h|--help)         cmd_help ;;
    *)                      warn "Unknown command: $cmd"; cmd_help; exit 1 ;;
  esac
}
main "$@"
