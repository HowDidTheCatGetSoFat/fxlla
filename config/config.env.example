# Copy this file to  ~/.config/fxlla/config.env  and adjust as needed.
# Any variable here can also be overridden by exporting it in the shell.

# Where models are cached. Unset, fxlla uses ~/.local/share/fxlla/store; models
# run to tens of GB each, so point this at a disk with room. The directory must
# exist (or be creatable) before `fxlla setup`.
# FXLLA_STORE="/Volumes/your-disk/llm"

# Download cap in megabits per second. 25 = ~3.1 MB/s.
FXLLA_RATE_MBIT=25
# Confirm before transferring more than this many GB. At a terminal that is a
# prompt; a script, an agent, or an MCP call gets a refusal telling it to pass
# --yes. Raise it if you want fewer stops.
FXLLA_CONFIRM_ABOVE_GB=5
# Set to 1 to authorize large downloads without being asked. Prefer --yes per
# command; this turns the check off everywhere.
# FXLLA_ASSUME_YES=1
# Pull transfer: aria2 (bandwidth-capped, default) or hf (Hugging Face CLI via
# uvx; robust for xet/LFS repos, no cap). Override per pull with --downloader.
FXLLA_DOWNLOADER=aria2

# Where the local server listens (OpenAI-compatible).
FXLLA_HOST=127.0.0.1
FXLLA_PORT=8080

# Model started by `fxlla on` with no arguments.
FXLLA_DEFAULT_MODEL=qwen3-coder

# Keep-warm: idle minutes before the server auto-stops. 0 = never.
#
# This is not only about RAM. Unloading a backend takes its PROMPT CACHE with
# it, and that cache is what makes a long conversation usable: the first turn
# pays the full prefill, every turn after it reuses the KV cache and costs
# almost nothing. Measured on a 42 GB model with a 18k-token conversation:
# 21.5 s for the first turn, 0.2 s for the next two - and 80 s once the cache
# is gone, because the reload and the whole prefill are paid again.
#
# So the number to think about is not "how long before I stop caring about the
# RAM", it is "how long might I go without typing". A five minute setting on an
# interactive session evicts the cache every time you stop to read something.
# The LRU still frees memory whenever another model needs it, so this only
# governs reclamation while idle.
FXLLA_KEEP_WARM=10

# --- GGUF models only (llama-server) ---
# Ceiling on the context window, not the window itself. Each gguf model is
# served what IT was trained for - read from its own header - capped by this.
# One number for every model was wrong in both directions: it served a 27B
# trained to 262k at 8k, and asked a 7B for more than it had ever seen. Raise
# it to let a big-window model use its full window; the cost is RAM, because
# llama-server allocates the whole KV cache up front and it is paid whether
# the context is filled or not. A rough guide for a 27B: 32k is under 2 GB,
# 262k is about 16 GB, on top of the weights.
FXLLA_CTX=32768

# Serve the window a model ADVERTISES instead of the one it was trained for.
# Only meaningful where rope scaling is baked into the file: a model shipped
# with a YaRN factor of 4 headlines 1048576 and was trained at 262144. The
# stretch is the only reason the bigger number is reachable, so it stays
# enabled there - and it costs attention quality across a window almost nobody
# fills. For a 27B that window is about 64 GB of KV cache, allocated up front
# whether you use it or not, on top of the weights. FXLLA_CTX still caps it, so
# raise both or you get the trained window and no stretch, which is the right
# answer rather than a surprise.
# FXLLA_ROPE_STRETCH=1
FXLLA_NGL=999           # layers offloaded to the GPU (999 = all)

# Extra flags for the server (mlx_lm.server, llama-server or omlx depending on
# model). omlx serve uses parse_known_args, so any flag it does not recognise is
# ignored rather than fatal.
FXLLA_SERVER_ARGS=""

# --- OMLX models only (omlx serve, the optional third engine) ---
# Path to the omlx binary. omlx's build pins mlx==0.32.0, so it is normally kept
# in its own venv rather than on PATH (which would fight the MLX engine's mlx);
# point fxlla at that venv's console script. Defaults to `omlx` on PATH.
# FXLLA_OMLX_BIN=$HOME/omlx/.venv/bin/omlx
#
# omlx keeps per-server state (settings, logs) and its SSD KV cache under a
# base path. Every backend gets its OWN so concurrent instances never race the
# shared ~/.omlx: settings.json is a non-atomic rewrite and the SSD cache index
# is thread- not process-safe. Defaults to $FXLLA_STORE/models/.omlx/<alias>.
# Point it at a fast internal SSD if your weights live on a slower external disk
# - the whole value of this engine is that the KV cache is on fast storage.
# FXLLA_OMLX_BASE=
#
# Ceiling on the on-disk KV cache per model. omlx's own default is 100GB, which
# can quietly fill a disk; capped here at 20GB. The cache trades disk for a
# skipped prefill, so raise it if you have room and reuse long prefixes.
FXLLA_OMLX_CACHE_MAX=20GB

# --- MTPLX models only (mtplx serve, the optional fourth engine) ---
# MTPLX is the other MTP engine (native speculative decode, no external drafter).
# Like omlx it pins its own mlx and lives in a venv rather than on PATH, so point
# fxlla at that venv's console script. Defaults to `mtplx` on PATH.
# FXLLA_MTPLX_BIN=$HOME/mtplx/.venv/bin/mtplx
#
# Per-model state + SSD session cache base (see FXLLA_OMLX_BASE for the why).
# Defaults to $FXLLA_STORE/models/.mtplx/<alias>.
# FXLLA_MTPLX_BASE=
#
# Ceiling on the SSD session cache per model. MTPLX's own default is 100GB, which
# can fill a disk; capped here at 20GB.
FXLLA_MTPLX_CACHE_MAX=20GB
#
# Extra flags for `mtplx serve` ONLY. Kept separate from FXLLA_SERVER_ARGS
# because mtplx uses strict argparse and would reject an mlx_lm/llama-server flag.
FXLLA_MTPLX_ARGS=""

# --- multi-model gateway (fxlla serve) ---
# First internal port for on-demand backends (each model gets its own).
FXLLA_BACKEND_PORT_BASE=8100
# RAM budget for resident models. Leave unset to derive from the GPU limit.
# FXLLA_GATEWAY_BUDGET_MB=61440

# --- RAG knowledge bases (fxlla kb) ---
# Port for the local embedding server (llama.cpp) used by 'fxlla kb'.
FXLLA_EMBED_PORT=8090
# Which catalog alias supplies the embeddings ('fxlla models', role 'embed').
# Unset means 'embed' (nomic-embed-text v1.5, 768-dim), what every base built so
# far was indexed with. Pull the alias first, then switch. Vectors from two
# models are not comparable, so after changing this re-embed each base with
# 'fxlla kb reindex <name>'; compare candidates with 'fxlla kb eval'.
# FXLLA_EMBED_MODEL=embed-qwen3
# Set to 1 to use the sqlite-vec KNN index for `fxlla kb search` instead of the
# default brute-force cosine scan. It runs rag/core.py under `uv run --with
# sqlite-vec` (uv required) and falls back to the scan when unavailable.
# FXLLA_KB_INDEX=1
# Advanced: force a specific interpreter for rag/core.py (must allow loading
# sqlite extensions for the index). Leave unset to let FXLLA_KB_INDEX decide.
# FXLLA_KB_PYTHON=/path/to/venv/bin/python

# --- model evals (fxlla eval) ---
# Port for the temporary server each evaluated model runs on.
# FXLLA_EVAL_PORT=8097

# --- code graph (fxlla graph) ---
# The graph is stored in an embedded KuzuDB and runs under
# `uv run --with kuzu==0.11.3 --with tree-sitter --with tree-sitter-language-pack`
# by default (kuzu pinned: upstream was archived after the Oct 2025 Apple
# acquisition; tree-sitter parses non-Python languages). Set this to an
# interpreter that already has those packages to skip uv.
# FXLLA_GRAPH_PYTHON=/path/to/venv/bin/python

# RAM reserved for the OS when running `fxlla ram auto` (the rest goes to the GPU).
FXLLA_RAM_RESERVE_MB=8192

# An image sent to a model that cannot read one used to fail in the backend
# ("Only 'text' content type is supported"). The gateway now reads it with a
# model that can and hands the chosen one a description - two models, one
# request. Set to 0 to go back to failing.
# The image is forwarded untouched only when two things agree: the catalog
# gives the model role 'vision', and a multimodal projector sits on disk next
# to its weights. The projector says an image CAN reach it; the role says its
# eyes were meant to be used. Some models ship a vision tower inherited from
# their base and never tuned, and for one of those a description from a model
# chosen for the job beats its own untested sight - so an undeclared model
# gets the description, even though it could have taken the image.
# FXLLA_VISION_ROUTING=0
# Which model does the reading. Unset means the first catalog alias with role
# 'vision' that actually has a multimodal projector on disk. Naming one here is
# itself the declaration, so it only needs the projector.
# FXLLA_VISION_MODEL=vision
# Images one request may carry. Each is read separately with its own timeout.
# FXLLA_VISION_MAX_IMAGES=4

# --- media generation (fxlla media) ---
# Default image model (see `fxlla media models`).
FXLLA_MEDIA_MODEL=z-image-turbo
# Directory holding the mflux-cv binaries (image models, edit, upscale), for
# a custom venv off the PATH. Unset means PATH, where `fxlla setup --media`
# puts them. FXLLA_EDIT_BIN / FXLLA_UPSCALE_BIN still win for their commands.
# FXLLA_MFLUX_BIN_DIR=/path/to/venv/bin
# Hugging Face cache holding the image diffusion weights (empty = HF default).
# Point at the directory that CONTAINS hub/, not at hub/ itself.
#
# Several are allowed, colon separated like PATH, for when the weights outgrow
# one disk. The FIRST is where new downloads go; all of them are searched for
# what is already here, and a render is handed the one that actually holds the
# model it needs. Order matters: put the disk with room first.
# FXLLA_MEDIA_HF_HOME=/Volumes/your-disk/huggingface
# FXLLA_MEDIA_HF_HOME=/Volumes/roomy-disk/huggingface:/Volumes/old-disk/huggingface
# Directories holding LoRAs, colon separated. The civitai download directory
# is always searched; add wherever you keep your own (a training project, a
# directory shared with another tool). See: fxlla media loras
# FXLLA_LORA_DIRS=/path/to/project/loras:/path/to/other/loras
# Path to the ltx-2-mlx binary for video; it often lives in a project venv.
# FXLLA_VIDEO_BIN=/path/to/.venv/bin/ltx-2-mlx
# Output directory for generated media (default <FXLLA_STORE>/media).
# FXLLA_MEDIA_OUT=/Volumes/your-disk/media
# Set to 0 to stop the desktop notification a finished (or failed) background
# render posts on macOS. It exists because nothing in MCP can reopen a finished
# agent turn to announce a render, so the model can only tell you when asked.
# With terminal-notifier on PATH, clicking the notification reveals the file in
# Finder; without it the notification is attributed to Finder so a click at
# least opens a file browser rather than Script Editor, which is what owns a
# plain osascript notification and has nothing to do with the render.
# FXLLA_MEDIA_NOTIFY=0
# Seconds a media MCP tool call may block before it answers with a job id.
# Zero, because the quickest render measured here takes about a minute: waiting
# only spends the caller's turn to reach the same job id, and blocks whoever is
# driving from doing anything else meanwhile. Raise it if you would rather short
# renders come back as a path, and keep it under the MCP timeout of whatever is
# calling: past that the client reports a timeout, the render keeps going
# invisibly, and an agent that cannot tell the two apart submits it again.
# FXLLA_MCP_WAIT_S=0
# Voice (text to speech via mlx-audio / Chatterbox):
# interpreter with mlx-audio. Unset, fxlla resolves it: the uv tool venv that
# `fxlla setup --media` installs, else python3. Set only to override.
# FXLLA_VOICE_PYTHON=/path/to/venv/bin/python
# a reference voice wav that sets the timbre (required for voice),
# FXLLA_VOICE_REF=/path/to/reference-voice.wav
# and the default language code.
FXLLA_VOICE_LANG=en

# Hugging Face token, only for gated repositories. Leave unset otherwise.
# HF_TOKEN=hf_xxx

# Civitai API token, for `fxlla pull civitai:<id>` (LoRAs, checkpoints).
# CIVITAI_TOKEN in civitai.com account settings. Leave unset otherwise.
# FXLLA_CIVITAI_TOKEN=

# --- releasing the macOS app (maintainers only) -----------------------------
# Only needed to build a distributable .dmg; nothing else in fxlla reads these.
#
# The notarytool keychain profile NAME that `app/package-dmg.sh --notarize`
# uses when you do not pass one. The profile itself is created once with
# `xcrun notarytool store-credentials <name> ...` and the SECRET stays in the
# keychain - this is a label, not a credential.
#
# It is listed here because its absence was the bug: the name lived only in a
# config file nothing loads, so "have we ever notarized?" got answered by
# searching the keychain, finding nothing, and saying no - while Apple's own
# history had three Accepted submissions. `app/package-dmg.sh --check` now
# prints the profile and whether it authenticates; that is the question to ask.
# FXLLA_NOTARY_PROFILE=fxlla-notary
#
# The signing certificate, when it is not the default in app/sign-lib.sh.
# FXLLA_SIGN_ID="Developer ID Application: your name (TEAMID)"

# Stop a runaway agent: the same tool call returning the same result this many
# times in a row is refused with HTTP 400 (type=tool_loop), naming the call.
# 0 disables. A local model here ran one command 240 times over 8.5 hours, and
# separately wrote one file 189 times in under four minutes; the longest
# LEGITIMATE identical run ever recorded on this machine was 4 (a media job
# being polled), so anything above that is safe.
# FXLLA_LOOP_LIMIT=8
